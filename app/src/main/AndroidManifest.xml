<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Permissions -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Hardware features -->
    <uses-feature android:name="android.hardware.camera" android:required="true" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />
    <uses-feature android:name="android.hardware.camera.front" android:required="false" />

    <application
        android:name=".HealthScannerApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.HealthScanner">

        <!-- LoginActivity as launcher -->
        <activity
            android:name=".LoginActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.HealthScanner.Login">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- SignUpActivity - THIS WAS MISSING! -->
        <activity
            android:name=".SignUpActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:parentActivityName=".LoginActivity"
            android:theme="@style/Theme.HealthScanner" />

        <!-- HistoryActivity -->
        <activity
            android:name=".HistoryActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:parentActivityName=".MainActivity"
            android:theme="@style/Theme.HealthScanner" />

        <!-- MainActivity -->
        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.HealthScanner" />

        <!-- SearchActivity -->
        <activity
            android:name=".SearchActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:parentActivityName=".MainActivity"
            android:theme="@style/Theme.HealthScanner" />



        <!-- VerticalScannerActivity -->
        <activity
            android:name=".VerticalScannerActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:parentActivityName=".MainActivity"
            android:theme="@style/Theme.HealthScanner.Scanner" />

        <!-- ApiDetectionResultActivity -->
        <activity
            android:name=".ApiDetectionResultActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:parentActivityName=".VerticalScannerActivity"
            android:theme="@style/Theme.HealthScanner" />

        <!-- ProductDetailsActivitySimple -->
        <activity
            android:name=".ProductDetailsActivitySimple"
            android:exported="false"
            android:screenOrientation="portrait"
            android:parentActivityName=".MainActivity"
            android:theme="@style/Theme.HealthScanner" />

        <!-- ProductDetailsEnhancedActivity -->
        <activity
            android:name=".ProductDetailsEnhancedActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:parentActivityName=".MainActivity"
            android:theme="@style/Theme.HealthScanner.Profile" />

        <!-- SimpleProductActivity for testing -->
        <activity
            android:name=".SimpleProductActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:parentActivityName=".MainActivity"
            android:theme="@style/Theme.HealthScanner.Profile" />

        <!-- ProfileActivity -->
        <activity
            android:name=".ProfileActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:parentActivityName=".MainActivity"
            android:theme="@style/Theme.HealthScanner.Profile" />

        <!-- AnalyticsActivity -->
        <activity
            android:name=".AnalyticsActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:parentActivityName=".MainActivity"
            android:theme="@style/Theme.HealthScanner" />

        <!-- SettingsActivity -->
        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:parentActivityName=".ProfileActivity"
            android:theme="@style/Theme.HealthScanner" />

        <!-- AutoSyncService for background data synchronization -->
        <service
            android:name=".services.AutoSyncService"
            android:exported="false" />

        <!-- Firebase Test Activity for debugging -->
        <activity
            android:name=".FirebaseTestActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.HealthScanner" />

        <activity
            android:name=".ProductSelectionActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.HealthScanner" />

        <activity
            android:name=".ProductCreationActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.HealthScanner" />

        <!-- FileProvider for camera photo capture -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>