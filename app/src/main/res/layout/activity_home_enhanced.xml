<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <!-- ==================== MAIN CONTENT ==================== -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:animateLayoutChanges="true"
        android:background="@drawable/home_bg_clean">

    <!-- Main Scrollable Content -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:paddingBottom="90dp"
        android:overScrollMode="never"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="16dp"
            android:paddingBottom="@dimen/spacing_xxxl">

            <!-- ==================== TOP BAR ==================== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp">

                <!-- Profile Image (opens sidebar) -->
                <ImageView
                    android:id="@+id/profileImage"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:src="@drawable/ic_person"
                    android:background="@drawable/bg_profile_circle"
                    android:scaleType="centerInside"
                    android:padding="8dp"
                    android:contentDescription="Profile Picture"
                    app:tint="@color/health_teal" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <!-- Notification Bell -->
                <FrameLayout
                    android:id="@+id/notificationButton"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_notification_circle"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackgroundBorderless">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_notifications"
                        android:contentDescription="Notifications"
                        app:tint="#1B1B1B" />
                </FrameLayout>
            </LinearLayout>

            <!-- ==================== HEADLINE ==================== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingEnd="60dp"
                android:paddingTop="8dp"
                android:paddingBottom="4dp">

                <TextView
                    android:id="@+id/welcomeText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Let's Check Your"
                    android:textSize="30sp"
                    android:textStyle="bold"
                    android:textColor="#1B1B1B"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="-0.02"
                    android:lineSpacingMultiplier="1.1" />

                <TextView
                    android:id="@+id/subtitleText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Meal Together"
                    android:textSize="30sp"
                    android:textStyle="bold"
                    android:textColor="@color/health_teal"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="-0.02"
                    android:lineSpacingMultiplier="1.1" />
            </LinearLayout>

            <!-- ==================== SEARCH BAR ==================== -->
            <LinearLayout
                android:id="@+id/searchCard"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:layout_marginTop="20dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">

                <!-- Search Input Area -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginEnd="10dp"
                    android:background="@drawable/bg_search_bar"
                    android:gravity="center_vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_search"
                        android:contentDescription="Search"
                        app:tint="#999B96"
                        android:layout_marginEnd="12dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Scan or search a food..."
                        android:textSize="15sp"
                        android:textColor="#999B96"
                        android:fontFamily="sans-serif" />
                </LinearLayout>

                <!-- Filter button -->
                <FrameLayout
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:background="@drawable/bg_filter_button"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackgroundBorderless">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_filter_tune"
                        android:contentDescription="Filter"
                        app:tint="#1B1B1B" />
                </FrameLayout>
            </LinearLayout>

            <!-- ==================== STATS ROW ==================== -->
            <LinearLayout
                android:id="@+id/statsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingTop="24dp"
                android:weightSum="3">

                <!-- Total Scans -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_stat_chip"
                    android:orientation="vertical"
                    android:paddingTop="16dp"
                    android:paddingBottom="16dp"
                    android:gravity="center">

                    <TextView
                        android:id="@+id/totalScansNumber"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:textColor="#1B1B1B"
                        android:fontFamily="sans-serif-medium" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Total Scans"
                        android:textSize="11sp"
                        android:textColor="#999B96"
                        android:fontFamily="sans-serif"
                        android:layout_marginTop="4dp" />
                </LinearLayout>

                <!-- Avg Health Score -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_stat_chip"
                    android:orientation="vertical"
                    android:paddingTop="16dp"
                    android:paddingBottom="16dp"
                    android:gravity="center">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:id="@+id/healthScoreNumber"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="--"
                            android:textSize="22sp"
                            android:textStyle="bold"
                            android:textColor="#1B1B1B"
                            android:fontFamily="sans-serif-medium" />

                        <TextView
                            android:id="@+id/healthEmoji"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🌟"
                            android:textSize="16sp"
                            android:layout_marginStart="4dp" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Avg Score"
                        android:textSize="11sp"
                        android:textColor="#999B96"
                        android:fontFamily="sans-serif"
                        android:layout_marginTop="4dp" />
                </LinearLayout>

                <!-- Saved Items -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_stat_chip"
                    android:orientation="vertical"
                    android:paddingTop="16dp"
                    android:paddingBottom="16dp"
                    android:gravity="center">

                    <TextView
                        android:id="@+id/savedItemsNumber"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:textColor="#1B1B1B"
                        android:fontFamily="sans-serif-medium" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Saved"
                        android:textSize="11sp"
                        android:textColor="#999B96"
                        android:fontFamily="sans-serif"
                        android:layout_marginTop="4dp" />
                </LinearLayout>
            </LinearLayout>

            <!-- ==================== RECENT SCANS SECTION ==================== -->
            <LinearLayout
                android:id="@+id/recentScansSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="28dp">

                <!-- Section Header -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:paddingBottom="14dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Last scans"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="#1B1B1B"
                        android:fontFamily="sans-serif-medium" />

                    <TextView
                        android:id="@+id/viewAllScans"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="See all"
                        android:textSize="14sp"
                        android:textColor="#999B96"
                        android:fontFamily="sans-serif"
                        android:background="?attr/selectableItemBackground"
                        android:padding="@dimen/spacing_sm" />
                </LinearLayout>

                <!-- Recent Scans Horizontal RecyclerView -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recentScansRecyclerView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:clipToPadding="false"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    tools:listitem="@layout/item_recent_scan_enhanced" />

                <!-- Empty State (shown when no scans) -->
                <LinearLayout
                    android:id="@+id/emptyStateContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:paddingTop="20dp"
                    android:paddingBottom="20dp"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_recent_scan_card"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="32dp">

                        <ImageView
                            android:layout_width="64dp"
                            android:layout_height="64dp"
                            android:src="@drawable/ic_barcode_scan"
                            android:contentDescription="No scans"
                            app:tint="#C8CBC5" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="No scans yet"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="#1B1B1B"
                            android:fontFamily="sans-serif-medium"
                            android:layout_marginTop="16dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Tap the scan button to analyze your first product"
                            android:textSize="13sp"
                            android:textColor="#999B96"
                            android:fontFamily="sans-serif"
                            android:gravity="center"
                            android:layout_marginTop="6dp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- ==================== HEALTH TIP ==================== -->
            <LinearLayout
                android:id="@+id/tipCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_tip_card_clean"
                android:orientation="horizontal"
                android:padding="20dp"
                android:gravity="center_vertical">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginEnd="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="💡 Daily Tip"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="@color/health_teal"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="0.06" />

                    <TextView
                        android:id="@+id/healthTipText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Choose products with less than 5g of sugar per serving for better health!"
                        android:textSize="14sp"
                        android:textColor="#2E3630"
                        android:fontFamily="sans-serif"
                        android:lineSpacingMultiplier="1.3"
                        android:layout_marginTop="6dp" />
                </LinearLayout>

                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:src="@drawable/ic_health_score"
                    android:contentDescription="Health Tip"
                    app:tint="@color/health_teal" />
            </LinearLayout>

            <!-- ==================== QUICK ACTION: SCAN BUTTON ==================== -->
            <LinearLayout
                android:id="@+id/quickScanButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_scan_button_pill"
                android:gravity="center"
                android:orientation="horizontal"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_barcode_scan"
                    android:contentDescription="Scan"
                    app:tint="#FFFFFF"
                    android:layout_marginEnd="10dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Scan a Product"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.02" />
            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- Classy Bottom Navigation -->
    <include layout="@layout/bottom_nav_classy" />

    <!-- Animation Overlay Container for Circular Reveal -->
    <include layout="@layout/animation_overlay_container" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- ==================== SIDEBAR DRAWER ==================== -->
    <LinearLayout
        android:id="@+id/sidebarDrawer"
        android:layout_width="300dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:orientation="vertical"
        android:background="@drawable/bg_sidebar_panel"
        android:elevation="8dp"
        android:fitsSystemWindows="true">

        <!-- Sidebar Header with Profile -->
        <LinearLayout
            android:id="@+id/sidebarHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingTop="48dp"
            android:paddingBottom="24dp"
            android:paddingStart="24dp"
            android:paddingEnd="24dp">

            <!-- Profile Avatar -->
            <ImageView
                android:id="@+id/sidebarProfileImage"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:src="@drawable/ic_person"
                android:background="@drawable/bg_sidebar_profile_circle"
                android:scaleType="centerInside"
                android:padding="14dp"
                android:contentDescription="Profile Avatar"
                app:tint="@color/health_teal" />

            <!-- User Name -->
            <TextView
                android:id="@+id/sidebarUserName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="User"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#1B1B1B"
                android:fontFamily="sans-serif-medium"
                android:layout_marginTop="12dp" />

            <!-- User Email -->
            <TextView
                android:id="@+id/sidebarUserEmail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="user@example.com"
                android:textSize="13sp"
                android:textColor="#999B96"
                android:fontFamily="sans-serif"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:background="@drawable/bg_sidebar_divider" />

        <!-- Menu Items -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingTop="12dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <!-- My Profile -->
            <LinearLayout
                android:id="@+id/sidebarMyProfile"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:background="@drawable/bg_sidebar_menu_item"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_person"
                    android:contentDescription="My Profile"
                    app:tint="#4CAF50" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="My Profile"
                    android:textSize="15sp"
                    android:textColor="#1B1B1B"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginStart="16dp" />
            </LinearLayout>

            <!-- Scan History -->
            <LinearLayout
                android:id="@+id/sidebarScanHistory"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_sidebar_menu_item"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_history"
                    android:contentDescription="Scan History"
                    app:tint="#4CAF50" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Scan History"
                    android:textSize="15sp"
                    android:textColor="#1B1B1B"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginStart="16dp" />
            </LinearLayout>

            <!-- Analytics -->
            <LinearLayout
                android:id="@+id/sidebarAnalytics"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_sidebar_menu_item"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_health_score"
                    android:contentDescription="Analytics"
                    app:tint="#4CAF50" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Analytics"
                    android:textSize="15sp"
                    android:textColor="#1B1B1B"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginStart="16dp" />
            </LinearLayout>

            <!-- Settings -->
            <LinearLayout
                android:id="@+id/sidebarSettings"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_sidebar_menu_item"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_settings"
                    android:contentDescription="Settings"
                    app:tint="#4CAF50" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Settings"
                    android:textSize="15sp"
                    android:textColor="#1B1B1B"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginStart="16dp" />
            </LinearLayout>

            <!-- Divider before bottom section -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="12dp"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_sidebar_divider" />

            <!-- Help & Support -->
            <LinearLayout
                android:id="@+id/sidebarHelp"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_sidebar_menu_item"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_support"
                    android:contentDescription="Help and Support"
                    app:tint="#4CAF50" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Help &amp; Support"
                    android:textSize="15sp"
                    android:textColor="#1B1B1B"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginStart="16dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Logout Button at Bottom -->
        <LinearLayout
            android:id="@+id/sidebarLogout"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="28dp"
            android:paddingEnd="28dp"
            android:layout_marginBottom="24dp"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_sidebar_menu_item"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_logout"
                android:contentDescription="Logout"
                app:tint="#E53935" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Logout"
                android:textSize="15sp"
                android:textColor="#E53935"
                android:fontFamily="sans-serif-medium"
                android:layout_marginStart="16dp" />
        </LinearLayout>
    </LinearLayout>

</androidx.drawerlayout.widget.DrawerLayout>
