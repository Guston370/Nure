<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:animateLayoutChanges="true"
    tools:context=".MainActivity">

    <!-- Main Scrollable Content -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:background="@drawable/home_background_gradient"
        android:clipToPadding="false"
        android:paddingBottom="90dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="@dimen/spacing_xxxl">

            <!-- Header Section with Gradient -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/headerSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/header_gradient_background"
                android:paddingStart="@dimen/spacing_lg"
                android:paddingEnd="@dimen/spacing_lg"
                android:paddingTop="@dimen/spacing_xl"
                android:paddingBottom="@dimen/spacing_lg">

                <!-- App Logo -->
                <ImageView
                    android:id="@+id/appLogo"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/ic_health_scanner_logo"
                    android:contentDescription="Health Scanner Logo"
                    android:layout_marginBottom="@dimen/spacing_sm"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

                <!-- Welcome Text -->
                <TextView
                    android:id="@+id/welcomeText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="Welcome! 👋"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:alpha="0"
                    android:translationY="-20dp"
                    android:animation="@anim/fade_in_slide_down"
                    app:layout_constraintTop_toBottomOf="@+id/appLogo"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/profileImage" />

                <!-- Subtitle -->
                <TextView
                    android:id="@+id/subtitleText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="Ready to make healthier choices today?"
                    android:textSize="16sp"
                    android:textColor="@color/white"
                    android:alpha="0.9"
                    android:layout_marginTop="@dimen/spacing_xs"
                    app:layout_constraintTop_toBottomOf="@+id/welcomeText"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/profileImage" />

                <!-- Profile Image -->
                <ImageView
                    android:id="@+id/profileImage"
                    android:layout_width="@dimen/avatar_size_large"
                    android:layout_height="@dimen/avatar_size_large"
                    android:src="@drawable/ic_person"
                    android:background="@drawable/card_background_elevated"
                    android:scaleType="centerCrop"
                    android:contentDescription="Profile Picture"
                    app:tint="@color/health_teal"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Quick Scan Button (Prominent) -->
            <androidx.cardview.widget.CardView
                android:id="@+id/searchCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/spacing_md"
                android:background="@drawable/scan_button_gradient"
                app:cardCornerRadius="20dp"
                app:cardElevation="12dp"
                android:animation="@anim/slide_up">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp"
                    android:gravity="center"
                    android:background="@drawable/scan_button_gradient">

                    <!-- Large Scan Icon -->
                    <ImageView
                        android:id="@+id/scanIcon"
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:src="@drawable/ic_barcode_scan"
                        android:contentDescription="Scan Product"
                        android:background="@drawable/scan_icon_background"
                        android:padding="16dp"
                        app:tint="@color/white" />

                    <!-- Scan Text -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tap to Scan Product"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="@color/white"
                        android:layout_marginTop="12dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Get instant health analysis"
                        android:textSize="14sp"
                        android:textColor="@color/white"
                        android:alpha="0.9"
                        android:layout_marginTop="4dp" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- Health Stats Overview -->
            <LinearLayout
                android:id="@+id/statsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_margin="@dimen/spacing_md"
                android:weightSum="3"
                android:animation="@anim/slide_up">

                <!-- Total Scans Card -->
                <androidx.cardview.widget.CardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="@dimen/spacing_xs"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="@dimen/elevation_sm"
                    app:cardBackgroundColor="@color/white">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/spacing_md"
                        android:gravity="center">

                        <TextView
                            android:id="@+id/totalScansNumber"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="24"
                            android:textSize="24sp"
                            android:textStyle="bold"
                            android:textColor="@color/health_teal" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Total Scans"
                            android:textSize="12sp"
                            android:textColor="@color/health_text_secondary"
                            android:layout_marginTop="@dimen/spacing_xs" />

                    </LinearLayout>

                </androidx.cardview.widget.CardView>

                <!-- Health Score Card -->
                <androidx.cardview.widget.CardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/spacing_xs"
                    android:layout_marginEnd="@dimen/spacing_xs"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="@dimen/elevation_sm"
                    app:cardBackgroundColor="@color/white">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/spacing_md"
                        android:gravity="center">

                        <TextView
                            android:id="@+id/healthScoreNumber"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0.0"
                            android:textSize="24sp"
                            android:textStyle="bold"
                            android:textColor="@color/health_mint_green" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Avg Score"
                            android:textSize="12sp"
                            android:textColor="@color/health_text_secondary"
                            android:layout_marginTop="@dimen/spacing_xs" />

                        <!-- Health Score Emoji -->
                        <TextView
                            android:id="@+id/healthEmoji"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="😊"
                            android:textSize="16sp"
                            android:layout_marginTop="@dimen/spacing_xs" />

                    </LinearLayout>

                </androidx.cardview.widget.CardView>

                <!-- Saved Items Card -->
                <androidx.cardview.widget.CardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/spacing_xs"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="@dimen/elevation_sm"
                    app:cardBackgroundColor="@color/white">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/spacing_md"
                        android:gravity="center">

                        <TextView
                            android:id="@+id/savedItemsNumber"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textSize="24sp"
                            android:textStyle="bold"
                            android:textColor="@color/health_soft_blue" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Saved Items"
                            android:textSize="12sp"
                            android:textColor="@color/health_text_secondary"
                            android:layout_marginTop="@dimen/spacing_xs" />

                    </LinearLayout>

                </androidx.cardview.widget.CardView>

            </LinearLayout>

            <!-- Recent Scans Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_margin="@dimen/spacing_md">

                <!-- Section Header -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="@dimen/spacing_md">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Recent Scans"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@color/health_text_primary" />

                    <TextView
                        android:id="@+id/viewAllScans"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="View All"
                        android:textSize="14sp"
                        android:textColor="@color/health_teal"
                        android:background="?attr/selectableItemBackground"
                        android:padding="@dimen/spacing_sm" />

                </LinearLayout>

                <!-- Recent Scans RecyclerView -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recentScansRecyclerView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:clipToPadding="false"
                    android:paddingStart="@dimen/spacing_sm"
                    android:paddingEnd="@dimen/spacing_sm"
                    android:animation="@anim/slide_in_right"
                    tools:listitem="@layout/item_recent_scan" />

            </LinearLayout>

            <!-- Health Tip of the Day -->
            <androidx.cardview.widget.CardView
                android:id="@+id/tipCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/spacing_md"
                app:cardCornerRadius="16dp"
                app:cardElevation="@dimen/elevation_md"
                android:animation="@anim/fade_in">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:background="@drawable/tip_card_gradient"
                    android:padding="@dimen/spacing_md"
                    android:gravity="center_vertical">

                    <!-- Tip Icon -->
                    <ImageView
                        android:layout_width="@dimen/icon_size_large"
                        android:layout_height="@dimen/icon_size_large"
                        android:src="@drawable/ic_health_score"
                        android:contentDescription="Health Tip"
                        app:tint="@color/white"
                        android:layout_marginEnd="@dimen/spacing_md" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="💡 Health Tip of the Day"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="@color/white"
                            android:layout_marginBottom="@dimen/spacing_xs" />

                        <TextView
                            android:id="@+id/healthTipText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Choose products with less than 5g of sugar per serving for better health!"
                            android:textSize="14sp"
                            android:textColor="@color/white"
                            android:alpha="0.9" />

                    </LinearLayout>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>


    <!-- Classy Bottom Navigation -->
    <include layout="@layout/bottom_nav_classy" />



    <!-- Animation Overlay Container for Circular Reveal -->
    <include layout="@layout/animation_overlay_container" />

</androidx.constraintlayout.widget.ConstraintLayout>