<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@color/card_background">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="20dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="📊 Today's Nutrition"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/primary_text_color" />

        <TextView
            android:id="@+id/todayDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Monday, Jan 15, 2024"
            android:textSize="12sp"
            android:textColor="@color/secondary_text_color" />

    </LinearLayout>

    <!-- Nutrition Summary -->
    <TextView
        android:id="@+id/nutritionSummary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Loading nutrition data..."
        android:textSize="14sp"
        android:textColor="@color/primary_text_color"
        android:lineSpacingExtra="4dp"
        android:layout_marginBottom="20dp" />

    <!-- Progress Bars -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Calories -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="🔥 Calories"
                android:textSize="14sp"
                android:textColor="@color/secondary_text_color" />

            <TextView
                android:id="@+id/dialogCaloriesProgress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1,320 / 2,000"
                android:textSize="14sp"
                android:textColor="@color/primary_text_color" />

        </LinearLayout>

        <ProgressBar
            android:id="@+id/dialogCaloriesProgressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:progress="66"
            android:progressTint="#2196F3"
            android:layout_marginBottom="12dp" />

        <!-- Sugar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="🍯 Sugar"
                android:textSize="14sp"
                android:textColor="@color/secondary_text_color" />

            <TextView
                android:id="@+id/dialogSugarProgress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="45g / 50g"
                android:textSize="14sp"
                android:textColor="@color/primary_text_color" />

        </LinearLayout>

        <ProgressBar
            android:id="@+id/dialogSugarProgressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:progress="90"
            android:progressTint="#FF9800"
            android:layout_marginBottom="12dp" />

        <!-- Protein -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="🥩 Protein"
                android:textSize="14sp"
                android:textColor="@color/secondary_text_color" />

            <TextView
                android:id="@+id/dialogProteinProgress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="65g / 100g"
                android:textSize="14sp"
                android:textColor="@color/primary_text_color" />

        </LinearLayout>

        <ProgressBar
            android:id="@+id/dialogProteinProgressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:progress="65"
            android:progressTint="#4CAF50"
            android:layout_marginBottom="12dp" />

        <!-- Fat -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="🧈 Fat"
                android:textSize="14sp"
                android:textColor="@color/secondary_text_color" />

            <TextView
                android:id="@+id/dialogFatProgress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="45g / 65g"
                android:textSize="14sp"
                android:textColor="@color/primary_text_color" />

        </LinearLayout>

        <ProgressBar
            android:id="@+id/dialogFatProgressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:progress="69"
            android:progressTint="#FFC107"
            android:layout_marginBottom="12dp" />

        <!-- Carbs -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="🍞 Carbs"
                android:textSize="14sp"
                android:textColor="@color/secondary_text_color" />

            <TextView
                android:id="@+id/dialogCarbsProgress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="180g / 300g"
                android:textSize="14sp"
                android:textColor="@color/primary_text_color" />

        </LinearLayout>

        <ProgressBar
            android:id="@+id/dialogCarbsProgressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:progress="60"
            android:progressTint="#9C27B0"
            android:layout_marginBottom="12dp" />

        <!-- Salt -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="🧂 Salt"
                android:textSize="14sp"
                android:textColor="@color/secondary_text_color" />

            <TextView
                android:id="@+id/dialogSaltProgress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1,200mg / 2,300mg"
                android:textSize="14sp"
                android:textColor="@color/primary_text_color" />

        </LinearLayout>

        <ProgressBar
            android:id="@+id/dialogSaltProgressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:progress="52"
            android:progressTint="#607D8B" />

    </LinearLayout>

    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="20dp"
        android:gravity="end">

        <Button
            android:id="@+id/closeButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Close"
            android:textColor="#2196F3"
            android:background="@android:color/transparent"
            android:textSize="16sp" />

    </LinearLayout>

</LinearLayout>
