<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.HealthScanner.CardView"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="@dimen/margin_small">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/spacing_md">

        <!-- Product Image -->
        <ImageView
            android:id="@+id/product_image"
            android:layout_width="@dimen/avatar_size_large"
            android:layout_height="@dimen/avatar_size_large"
            android:layout_marginEnd="@dimen/spacing_md"
            android:background="@drawable/card_background_elevated"
            android:contentDescription="Product Image"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_nutrition_facts"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:src="@drawable/ic_nutrition_facts" />

        <!-- Product Name -->
        <TextView
            android:id="@+id/product_name"
            style="@style/TextAppearance.HealthScanner.Body1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/spacing_sm"
            android:ellipsize="end"
            android:maxLines="2"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@+id/health_score_container"
            app:layout_constraintStart_toEndOf="@+id/product_image"
            app:layout_constraintTop_toTopOf="@+id/product_image"
            tools:text="Organic Whole Grain Cereal" />

        <!-- Brand Name -->
        <TextView
            android:id="@+id/brand_name"
            style="@style/TextAppearance.HealthScanner.Body2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xs"
            android:layout_marginEnd="@dimen/spacing_sm"
            android:ellipsize="end"
            android:maxLines="1"
            app:layout_constraintEnd_toStartOf="@+id/health_score_container"
            app:layout_constraintStart_toEndOf="@+id/product_image"
            app:layout_constraintTop_toBottomOf="@+id/product_name"
            tools:text="Nature's Best" />

        <!-- Scan Date -->
        <TextView
            android:id="@+id/scan_date"
            style="@style/TextAppearance.HealthScanner.Caption"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xs"
            android:layout_marginEnd="@dimen/spacing_sm"
            app:layout_constraintEnd_toStartOf="@+id/health_score_container"
            app:layout_constraintStart_toEndOf="@+id/product_image"
            app:layout_constraintTop_toBottomOf="@+id/brand_name"
            tools:text="2 hours ago" />

        <!-- Health Score Container -->
        <FrameLayout
            android:id="@+id/health_score_container"
            android:layout_width="@dimen/avatar_size_medium"
            android:layout_height="@dimen/avatar_size_medium"
            app:layout_constraintBottom_toBottomOf="@+id/product_image"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/product_image">

            <!-- Health Score Circle -->
            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:id="@+id/health_score_progress"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:progress="75"
                app:indicatorColor="@color/health_good"
                app:indicatorSize="@dimen/avatar_size_medium"
                app:trackColor="@color/md_theme_light_surfaceVariant"
                app:trackThickness="@dimen/margin_small"
                tools:progress="75" />

            <!-- Health Score Text -->
            <TextView
                android:id="@+id/health_score_text"
                style="@style/TextAppearance.HealthScanner.Body1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:textStyle="bold"
                tools:text="B+" />

        </FrameLayout>

        <!-- Nutrition Summary (Optional, can be hidden) -->
        <LinearLayout
            android:id="@+id/nutrition_summary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            android:orientation="horizontal"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/product_image"
            app:layout_constraintTop_toBottomOf="@+id/scan_date"
            tools:visibility="visible">

            <!-- Calories -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    style="@style/TextAppearance.HealthScanner.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Calories"
                    android:textColor="@color/calories_color" />

                <TextView
                    android:id="@+id/calories_value"
                    style="@style/TextAppearance.HealthScanner.Body2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textStyle="bold"
                    tools:text="150" />

            </LinearLayout>

            <!-- Sugar -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    style="@style/TextAppearance.HealthScanner.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sugar"
                    android:textColor="@color/sugar_color" />

                <TextView
                    android:id="@+id/sugar_value"
                    style="@style/TextAppearance.HealthScanner.Body2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textStyle="bold"
                    tools:text="3g" />

            </LinearLayout>

            <!-- Protein -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    style="@style/TextAppearance.HealthScanner.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Protein"
                    android:textColor="@color/protein_color" />

                <TextView
                    android:id="@+id/protein_value"
                    style="@style/TextAppearance.HealthScanner.Body2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textStyle="bold"
                    tools:text="8g" />

            </LinearLayout>

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>