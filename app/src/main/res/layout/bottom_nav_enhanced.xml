<?xml version="1.0" encoding="utf-8"?>
<!-- Enhanced Bottom Navigation with Improved Styling -->
<com.google.android.material.bottomnavigation.BottomNavigationView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/bottom_navigation"
    android:layout_width="0dp"
    android:layout_height="@dimen/bottom_nav_height_enhanced"
    android:background="@color/bottom_nav_background"
    android:elevation="@dimen/elevation_lg"
    android:animateLayoutChanges="true"
    android:paddingTop="16dp"
    android:paddingBottom="20dp"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    app:itemIconTint="@drawable/bottom_nav_icon_enhanced_selector"
    app:itemTextColor="@drawable/bottom_nav_text_enhanced_selector"
    app:itemTextAppearanceActive="@style/BottomNavTextEnhancedActive"
    app:itemTextAppearanceInactive="@style/BottomNavTextEnhancedInactive"
    app:itemIconSize="@dimen/bottom_nav_icon_size"
    app:labelVisibilityMode="selected"
    app:itemRippleColor="@color/health_mint_green"
    app:itemPaddingTop="8dp"
    app:itemPaddingBottom="8dp"
    app:itemActiveIndicatorStyle="@style/BottomNavActiveIndicator"
    app:layout_constraintBottom_toBottomOf="parent"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    app:menu="@menu/bottom_navigation_menu" />