<?xml version="1.0" encoding="utf-8"?>
<!--
  Sign-up screen — matches the inner app's white/teal Material 3 theme.
-->
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:overScrollMode="never"
    android:background="#FAFBF9"
    tools:context=".SignUpActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingBottom="40dp">

        <!-- ==================== TOP BAR ==================== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="12dp"
            android:paddingBottom="24dp">

            <!-- Back button -->
            <FrameLayout
                android:id="@+id/btn_back"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_notification_circle"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Go back">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_arrow_back"
                    android:contentDescription="Back"
                    app:tint="@color/text_primary_light" />
            </FrameLayout>

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />
        </LinearLayout>

        <!-- ==================== HEADLINE ==================== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="28dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Create account"
                android:textSize="30sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary_light"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="-0.02" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Start your health journey today"
                android:textSize="15sp"
                android:textColor="@color/text_secondary_light"
                android:fontFamily="sans-serif"
                android:layout_marginTop="6dp" />
        </LinearLayout>

        <!-- ==================== FORM CARD ==================== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_recent_scan_card"
            android:padding="24dp"
            android:elevation="4dp">

            <!-- Full name field -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_full_name"
                style="@style/Widget.HealthScanner.TextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Full name"
                android:layout_marginBottom="16dp"
                app:startIconDrawable="@drawable/ic_person"
                app:startIconTint="@color/health_teal"
                app:boxStrokeColor="@color/health_teal"
                app:boxBackgroundColor="@color/md_theme_light_surface">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_full_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPersonName|textCapWords"
                    android:maxLines="1"
                    android:autofillHints="name"
                    android:textColor="@color/text_primary_light"
                    android:textColorHint="@color/text_hint_light" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Email field -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_email"
                style="@style/Widget.HealthScanner.TextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Email address"
                android:layout_marginBottom="16dp"
                app:startIconDrawable="@drawable/ic_email"
                app:startIconTint="@color/health_teal"
                app:boxStrokeColor="@color/health_teal"
                app:boxBackgroundColor="@color/md_theme_light_surface">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_email"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textEmailAddress"
                    android:maxLines="1"
                    android:autofillHints="emailAddress"
                    android:textColor="@color/text_primary_light"
                    android:textColorHint="@color/text_hint_light" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Password field -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_password"
                style="@style/Widget.HealthScanner.TextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Password (min 8 characters)"
                android:layout_marginBottom="16dp"
                app:startIconDrawable="@drawable/ic_lock"
                app:startIconTint="@color/health_teal"
                app:endIconMode="password_toggle"
                app:endIconTint="@color/health_teal"
                app:boxStrokeColor="@color/health_teal"
                app:boxBackgroundColor="@color/md_theme_light_surface">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_password"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPassword"
                    android:maxLines="1"
                    android:autofillHints="newPassword"
                    android:textColor="@color/text_primary_light"
                    android:textColorHint="@color/text_hint_light" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Confirm password field -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_confirm_password"
                style="@style/Widget.HealthScanner.TextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Confirm password"
                android:layout_marginBottom="6dp"
                app:startIconDrawable="@drawable/ic_lock"
                app:startIconTint="@color/health_teal"
                app:endIconMode="password_toggle"
                app:endIconTint="@color/health_teal"
                app:boxStrokeColor="@color/health_teal"
                app:boxBackgroundColor="@color/md_theme_light_surface">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_confirm_password"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPassword"
                    android:maxLines="1"
                    android:autofillHints="newPassword"
                    android:textColor="@color/text_primary_light"
                    android:textColorHint="@color/text_hint_light" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Password hint -->
            <TextView
                android:id="@+id/tv_password_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Use at least 8 characters with letters and numbers"
                android:textSize="12sp"
                android:textColor="@color/text_hint_light"
                android:fontFamily="sans-serif"
                android:layout_marginBottom="24dp"
                android:paddingStart="4dp" />

            <!-- Terms & Conditions -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="24dp">

                <com.google.android.material.checkbox.MaterialCheckBox
                    android:id="@+id/cb_terms"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:buttonTint="@color/health_teal"
                    android:layout_marginEnd="4dp"
                    android:contentDescription="Accept terms and conditions" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="I agree to the "
                        android:textSize="13sp"
                        android:textColor="@color/text_secondary_light"
                        android:fontFamily="sans-serif" />

                    <TextView
                        android:id="@+id/tv_terms"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Terms &amp; Privacy Policy"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="@color/health_teal"
                        android:fontFamily="sans-serif-medium"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="View terms and privacy policy" />
                </LinearLayout>
            </LinearLayout>

            <!-- Create account button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_signup"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                style="@style/Widget.HealthScanner.Button.Gradient"
                android:text="Create Account"
                android:textSize="16sp"
                android:textStyle="bold"
                android:letterSpacing="0.02" />

            <!-- Progress indicator (hidden until sign-up begins) -->
            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:id="@+id/progress_signup"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="12dp"
                android:visibility="gone"
                app:indicatorColor="@color/health_teal"
                app:trackColor="@color/md_theme_light_surfaceVariant"
                app:indicatorSize="36dp" />

        </LinearLayout>

        <!-- ==================== DIVIDER ==================== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="28dp"
            android:layout_marginBottom="20dp">

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:background="@color/md_theme_light_outline" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="or continue with"
                android:textSize="13sp"
                android:textColor="@color/text_secondary_light"
                android:fontFamily="sans-serif"
                android:paddingStart="14dp"
                android:paddingEnd="14dp" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:background="@color/md_theme_light_outline" />
        </LinearLayout>

        <!-- ==================== GOOGLE SIGN-IN ==================== -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_google_signup"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            style="@style/Widget.HealthScanner.Button.Outlined"
            android:text="  Continue with Google"
            android:textSize="15sp"
            android:textColor="@color/text_primary_light"
            app:strokeColor="@color/md_theme_light_outline"
            app:strokeWidth="1.5dp"
            app:icon="@drawable/ic_google"
            app:iconGravity="textStart"
            app:iconPadding="12dp"
            android:backgroundTint="@color/md_theme_light_surface"
            android:contentDescription="Continue with Google" />

        <!-- ==================== SIGN-IN PROMPT ==================== -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="28dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Already have an account? "
                android:textSize="14sp"
                android:textColor="@color/text_secondary_light"
                android:fontFamily="sans-serif" />

            <TextView
                android:id="@+id/btn_signin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sign In"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/health_teal"
                android:fontFamily="sans-serif-medium"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Go to sign in" />
        </LinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
