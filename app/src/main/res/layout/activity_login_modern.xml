<?xml version="1.0" encoding="utf-8"?>
<!-- Premium Glassmorphism Login Screen with Smoked-Glass Aesthetics -->
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/gradient_page_background"
    tools:context=".LoginActivity">

    <!-- Main Content -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingTop="0dp"
            android:paddingBottom="40dp"
            android:gravity="center_horizontal">

            <!-- ===== HERO SECTION ===== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingTop="64dp"
                android:paddingBottom="24dp">

                <!-- Logo Container — Floating glass circle -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/logoContainer"
                    android:layout_width="110dp"
                    android:layout_height="110dp"
                    android:layout_marginBottom="20dp"
                    app:cardCornerRadius="55dp"
                    app:cardElevation="16dp"
                    app:cardBackgroundColor="#BF141419"
                    app:strokeWidth="1.5dp"
                    app:strokeColor="#1FFFFFFF">

                    <ImageView
                        android:id="@+id/logoImage"
                        android:layout_width="72dp"
                        android:layout_height="72dp"
                        android:layout_gravity="center"
                        android:contentDescription="Nure Logo"
                        android:scaleType="centerInside"
                        android:src="@drawable/nure_logo" />

                </com.google.android.material.card.MaterialCardView>

                <!-- Welcome Headline -->
                <TextView
                    android:id="@+id/loginTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Welcome Back"
                    android:textAppearance="@style/TextAppearance.Material3.DisplaySmall"
                    android:textColor="#FFF8FAFC"
                    android:textStyle="bold"
                    android:letterSpacing="-0.02"
                    android:layout_marginBottom="6dp" />

                <TextView
                    android:id="@+id/loginSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Your health journey continues"
                    android:textAppearance="@style/TextAppearance.Material3.BodyLarge"
                    android:textColor="#FF94A3B8"
                    android:textAlignment="center"
                    android:letterSpacing="0.01" />

            </LinearLayout>

            <!-- ===== GLASS LOGIN CARD ===== -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/loginCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@android:color/transparent"
                app:strokeWidth="0dp"
                android:background="@drawable/bg_smoked_glass_card">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <!-- Card Title -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Sign In"
                        android:textAppearance="@style/TextAppearance.Material3.HeadlineSmall"
                        android:textColor="#FFF8FAFC"
                        android:textStyle="bold"
                        android:layout_marginBottom="20dp" />

                    <!-- Email Input -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/til_email"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:hint="Email Address"
                        app:startIconDrawable="@drawable/ic_email"
                        app:startIconTint="#FF94A3B8"
                        app:hintTextColor="#FF94A3B8"
                        app:boxStrokeColor="@color/health_teal"
                        app:boxStrokeWidth="1dp"
                        app:boxBackgroundColor="#1A1A1E"
                        app:boxCornerRadiusTopStart="14dp"
                        app:boxCornerRadiusTopEnd="14dp"
                        app:boxCornerRadiusBottomStart="14dp"
                        app:boxCornerRadiusBottomEnd="14dp">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_email"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textEmailAddress"
                            android:maxLines="1"
                            android:textColor="#FFF8FAFC"
                            android:textColorHint="#FF475569" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Password Input -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/til_password"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:hint="Password"
                        app:startIconDrawable="@drawable/ic_lock"
                        app:startIconTint="#FF94A3B8"
                        app:endIconMode="password_toggle"
                        app:endIconTint="#FF94A3B8"
                        app:hintTextColor="#FF94A3B8"
                        app:boxStrokeColor="@color/health_teal"
                        app:boxStrokeWidth="1dp"
                        app:boxBackgroundColor="#1A1A1E"
                        app:boxCornerRadiusTopStart="14dp"
                        app:boxCornerRadiusTopEnd="14dp"
                        app:boxCornerRadiusBottomStart="14dp"
                        app:boxCornerRadiusBottomEnd="14dp">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_password"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textPassword"
                            android:maxLines="1"
                            android:textColor="#FFF8FAFC"
                            android:textColorHint="#FF475569" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Remember Me + Forgot Password Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="20dp">

                        <com.google.android.material.checkbox.MaterialCheckBox
                            android:id="@+id/cb_remember_me"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Remember me"
                            android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                            android:textColor="#FF94A3B8"
                            app:buttonTint="#FF94A3B8" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_forgot_password"
                            style="@style/Widget.Material3.Button.TextButton"
                            android:layout_width="wrap_content"
                            android:layout_height="48dp"
                            android:text="Forgot?"
                            android:textColor="@color/health_teal"
                            android:textSize="13sp"
                            android:letterSpacing="0.01"
                            android:paddingHorizontal="4dp" />

                    </LinearLayout>

                    <!-- Sign In Button — Premium Cyan gradient CTA -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_login"
                        style="@style/Widget.Material3.Button"
                        android:layout_width="match_parent"
                        android:layout_height="54dp"
                        android:layout_marginBottom="16dp"
                        android:text="Sign In"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        android:letterSpacing="0.02"
                        android:background="@drawable/bg_smoked_glass_button_primary"
                        app:backgroundTint="@null"
                        app:cornerRadius="14dp"
                        app:icon="@drawable/ic_arrow_forward"
                        app:iconGravity="end"
                        app:iconTint="#FFFFFF"
                        app:elevation="4dp" />

                    <!-- Divider with "or" -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginVertical="4dp">

                        <View
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1"
                            android:background="#1FFFFFFF" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="  or continue with  "
                            android:textAppearance="@style/TextAppearance.Material3.LabelMedium"
                            android:textColor="#FF94A3B8" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1"
                            android:background="#1FFFFFFF" />

                    </LinearLayout>

                    <!-- Google Sign-In Button -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_google_signin"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="54dp"
                        android:layout_marginTop="8dp"
                        android:text="Continue with Google"
                        android:textColor="#FFF8FAFC"
                        android:textSize="15sp"
                        app:cornerRadius="14dp"
                        app:strokeColor="#1FFFFFFF"
                        app:strokeWidth="1dp"
                        app:icon="@drawable/ic_google"
                        app:iconGravity="start"
                        app:iconTint="@null"
                        app:backgroundTint="#0CFFFFFF"
                        app:elevation="0dp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Sign Up Row -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Don't have an account?"
                    android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                    android:textColor="#FF94A3B8" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_signup"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:text="Sign Up"
                    android:textColor="@color/health_teal"
                    android:textStyle="bold"
                    android:textSize="15sp"
                    android:paddingHorizontal="8dp" />

            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- Loading Indicator -->
    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:id="@+id/progress_login"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone"
        app:indicatorColor="@color/health_teal"
        app:trackColor="#1FFFFFFF" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>