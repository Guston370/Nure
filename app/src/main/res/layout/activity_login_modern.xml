<?xml version="1.0" encoding="utf-8"?>
<!-- Premium Smoked-Glass Login Screen - Nure Health -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_auth_dark_gradient"
    tools:context=".LoginActivity">

    <!-- Ambient Glow Orb - Top Left -->
    <View
        android:layout_width="320dp"
        android:layout_height="320dp"
        android:layout_marginTop="-80dp"
        android:layout_marginStart="-80dp"
        android:background="@drawable/bg_ambient_orb_teal"
        android:alpha="0.18" />

    <!-- Ambient Glow Orb - Bottom Right -->
    <View
        android:layout_width="280dp"
        android:layout_height="280dp"
        android:layout_gravity="bottom|end"
        android:layout_marginBottom="-60dp"
        android:layout_marginEnd="-60dp"
        android:background="@drawable/bg_ambient_orb_mint"
        android:alpha="0.12" />

    <!-- Main Content Scroll -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingTop="72dp"
            android:paddingBottom="40dp"
            android:gravity="center_horizontal">

            <!-- ── HEADER ── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginBottom="36dp">

                <!-- Logo Container -->
                <FrameLayout
                    android:layout_width="96dp"
                    android:layout_height="96dp"
                    android:layout_marginBottom="24dp">

                    <!-- Glow ring -->
                    <View
                        android:layout_width="96dp"
                        android:layout_height="96dp"
                        android:background="@drawable/bg_logo_glow_ring"
                        android:alpha="0.6" />

                    <!-- Logo circle -->
                    <FrameLayout
                        android:layout_width="84dp"
                        android:layout_height="84dp"
                        android:layout_gravity="center"
                        android:background="@drawable/bg_logo_circle_gradient">

                        <ImageView
                            android:layout_width="56dp"
                            android:layout_height="56dp"
                            android:layout_gravity="center"
                            android:contentDescription="Nure Logo"
                            android:scaleType="centerInside"
                            android:src="@drawable/nure_logo" />
                    </FrameLayout>
                </FrameLayout>

                <!-- Brand name -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="nure"
                    android:textColor="#FFFFFFFF"
                    android:textSize="38sp"
                    android:letterSpacing="0.12"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-light"
                    android:layout_marginBottom="6dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Welcome back"
                    android:textColor="#B3FFFFFF"
                    android:textSize="16sp"
                    android:letterSpacing="0.04"
                    android:fontFamily="sans-serif" />

            </LinearLayout>

            <!-- ── GLASS FORM CARD ── -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp">

                <!-- Card shadow layer -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_card_shadow_deep"
                    android:alpha="0.5" />

                <!-- Glass card surface -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_glass_card_auth"
                    android:padding="28dp">

                    <!-- Section label -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Sign In"
                        android:textColor="#FFFFFFFF"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-medium"
                        android:layout_marginBottom="24dp" />

                    <!-- Email label -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Email"
                        android:textColor="#80FFFFFF"
                        android:textSize="12sp"
                        android:letterSpacing="0.08"
                        android:fontFamily="sans-serif-medium"
                        android:layout_marginBottom="8dp" />

                    <!-- Email Input -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/til_email"
                        style="@style/Widget.Material3.TextInputLayout.FilledBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="20dp"
                        android:hint="you@example.com"
                        app:startIconDrawable="@drawable/ic_email"
                        app:startIconTint="#661AFFD4"
                        app:hintTextColor="#661AFFD4"
                        app:boxBackgroundColor="#1A1AFFD4"
                        app:boxStrokeColor="#661AFFD4"
                        app:boxStrokeWidth="1dp"
                        app:boxCornerRadiusTopStart="14dp"
                        app:boxCornerRadiusTopEnd="14dp"
                        app:boxCornerRadiusBottomStart="14dp"
                        app:boxCornerRadiusBottomEnd="14dp">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_email"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textEmailAddress"
                            android:maxLines="1"
                            android:textColor="#FFFFFFFF"
                            android:textColorHint="#661AFFD4" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Password label -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Password"
                        android:textColor="#80FFFFFF"
                        android:textSize="12sp"
                        android:letterSpacing="0.08"
                        android:fontFamily="sans-serif-medium"
                        android:layout_marginBottom="8dp" />

                    <!-- Password Input -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/til_password"
                        style="@style/Widget.Material3.TextInputLayout.FilledBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:hint="••••••••"
                        app:startIconDrawable="@drawable/ic_lock"
                        app:startIconTint="#661AFFD4"
                        app:endIconMode="password_toggle"
                        app:endIconTint="#661AFFD4"
                        app:hintTextColor="#661AFFD4"
                        app:boxBackgroundColor="#1A1AFFD4"
                        app:boxStrokeColor="#661AFFD4"
                        app:boxStrokeWidth="1dp"
                        app:boxCornerRadiusTopStart="14dp"
                        app:boxCornerRadiusTopEnd="14dp"
                        app:boxCornerRadiusBottomStart="14dp"
                        app:boxCornerRadiusBottomEnd="14dp">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_password"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textPassword"
                            android:maxLines="1"
                            android:textColor="#FFFFFFFF"
                            android:textColorHint="#661AFFD4" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Remember / Forgot row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="28dp">

                        <com.google.android.material.checkbox.MaterialCheckBox
                            android:id="@+id/cb_remember_me"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Remember me"
                            android:textColor="#99FFFFFF"
                            android:textSize="13sp"
                            app:buttonTint="#FF1AFFD4" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1" />

                        <TextView
                            android:id="@+id/btn_forgot_password"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Forgot Password?"
                            android:textColor="#FF1AFFD4"
                            android:textSize="13sp"
                            android:fontFamily="sans-serif-medium"
                            android:clickable="true"
                            android:focusable="true"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:paddingVertical="8dp" />

                    </LinearLayout>

                    <!-- Sign In CTA Button -->
                    <FrameLayout
                        android:id="@+id/btn_login"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:background="@drawable/bg_btn_auth_primary"
                        android:clickable="true"
                        android:focusable="true"
                        android:layout_marginBottom="20dp">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:orientation="horizontal"
                            android:gravity="center">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Sign In"
                                android:textColor="#FF000000"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:fontFamily="sans-serif-medium"
                                android:layout_marginEnd="8dp" />

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:src="@drawable/ic_arrow_forward"
                                app:tint="#FF000000"
                                android:contentDescription="Arrow" />
                        </LinearLayout>

                        <!-- Loading indicator inside button -->
                        <com.google.android.material.progressindicator.CircularProgressIndicator
                            android:id="@+id/progress_login"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="center"
                            android:visibility="gone"
                            app:indicatorColor="#FF000000"
                            app:trackThickness="3dp" />
                    </FrameLayout>

                    <!-- Divider -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="20dp">

                        <View
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1"
                            android:background="#26FFFFFF" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="  or continue with  "
                            android:textColor="#66FFFFFF"
                            android:textSize="12sp"
                            android:letterSpacing="0.04" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1"
                            android:background="#26FFFFFF" />

                    </LinearLayout>

                    <!-- Google Sign In -->
                    <FrameLayout
                        android:id="@+id/btn_google_signin"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:background="@drawable/bg_btn_auth_secondary"
                        android:clickable="true"
                        android:focusable="true">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:orientation="horizontal"
                            android:gravity="center">

                            <ImageView
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:src="@drawable/ic_google"
                                android:contentDescription="Google"
                                android:layout_marginEnd="10dp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Continue with Google"
                                android:textColor="#FFFFFFFF"
                                android:textSize="15sp"
                                android:fontFamily="sans-serif-medium" />
                        </LinearLayout>
                    </FrameLayout>

                </LinearLayout>
            </FrameLayout>

            <!-- ── SIGN UP LINK ── -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Don't have an account? "
                    android:textColor="#80FFFFFF"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/btn_signup"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sign Up"
                    android:textColor="#FF1AFFD4"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:paddingVertical="8dp" />

            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</FrameLayout>