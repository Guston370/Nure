<?xml version="1.0" encoding="utf-8"?>
<!--
  Login screen — matches the inner app's white/teal Material 3 theme.
  Background: #FAFBF9 (same as home_bg_clean).
  Cards:      white, 24dp radius, 1dp #EAECE7 stroke (same as bg_recent_scan_card).
  Primary CTA: gradient from gradient_primary_start to gradient_primary_end.
  Typography: dark #1E293B on light surfaces; teal #0EA99F accent.
-->
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:overScrollMode="never"
    android:background="#FAFBF9"
    tools:context=".LoginActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingBottom="40dp">

        <!-- ==================== TOP SPACE + LOGO ==================== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingTop="24dp"
            android:paddingBottom="32dp">

            <!-- App icon circle -->
            <FrameLayout
                android:layout_width="88dp"
                android:layout_height="88dp"
                android:background="@drawable/bg_icon_circle_teal"
                android:layout_marginBottom="20dp">

                <ImageView
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_barcode_scan"
                    android:contentDescription="Nure logo"
                    app:tint="@color/white" />
            </FrameLayout>

            <!-- App name -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nure"
                android:textSize="34sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary_light"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="-0.02" />

            <!-- Tagline -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Your health, simplified"
                android:textSize="15sp"
                android:textColor="@color/text_secondary_light"
                android:fontFamily="sans-serif"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <!-- ==================== FORM CARD ==================== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_recent_scan_card"
            android:padding="24dp"
            android:elevation="4dp">

            <!-- Card headline -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Welcome back"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary_light"
                android:fontFamily="sans-serif-medium"
                android:layout_marginBottom="4dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sign in to continue"
                android:textSize="14sp"
                android:textColor="@color/text_secondary_light"
                android:fontFamily="sans-serif"
                android:layout_marginBottom="24dp" />

            <!-- Email field -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_email"
                style="@style/Widget.HealthScanner.TextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Email address"
                android:layout_marginBottom="16dp"
                app:startIconDrawable="@drawable/ic_email"
                app:startIconTint="@color/health_teal"
                app:boxStrokeColor="@color/health_teal"
                app:boxBackgroundColor="@color/md_theme_light_surface">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_email"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textEmailAddress"
                    android:maxLines="1"
                    android:autofillHints="emailAddress"
                    android:textColor="@color/text_primary_light"
                    android:textColorHint="@color/text_hint_light" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Password field -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_password"
                style="@style/Widget.HealthScanner.TextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Password"
                android:layout_marginBottom="8dp"
                app:startIconDrawable="@drawable/ic_lock"
                app:startIconTint="@color/health_teal"
                app:endIconMode="password_toggle"
                app:endIconTint="@color/health_teal"
                app:boxStrokeColor="@color/health_teal"
                app:boxBackgroundColor="@color/md_theme_light_surface">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_password"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPassword"
                    android:maxLines="1"
                    android:autofillHints="password"
                    android:textColor="@color/text_primary_light"
                    android:textColorHint="@color/text_hint_light" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Remember me / Forgot password row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="24dp">

                <com.google.android.material.checkbox.MaterialCheckBox
                    android:id="@+id/cb_remember_me"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Remember me"
                    android:textSize="13sp"
                    android:textColor="@color/text_secondary_light"
                    android:fontFamily="sans-serif"
                    android:buttonTint="@color/health_teal" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/btn_forgot_password"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Forgot password?"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/health_teal"
                    android:fontFamily="sans-serif-medium"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackgroundBorderless"
                    android:paddingStart="4dp"
                    android:contentDescription="Forgot password" />
            </LinearLayout>

            <!-- Sign in button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_login"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                style="@style/Widget.HealthScanner.Button.Gradient"
                android:text="Sign In"
                android:textSize="16sp"
                android:textStyle="bold"
                android:letterSpacing="0.02" />

            <!-- Progress indicator (hidden until sign-in begins) -->
            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:id="@+id/progress_login"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="12dp"
                android:visibility="gone"
                app:indicatorColor="@color/health_teal"
                app:trackColor="@color/md_theme_light_surfaceVariant"
                app:indicatorSize="36dp" />

        </LinearLayout>

        <!-- ==================== DIVIDER ==================== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="28dp"
            android:layout_marginBottom="20dp">

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:background="@color/md_theme_light_outline" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="or continue with"
                android:textSize="13sp"
                android:textColor="@color/text_secondary_light"
                android:fontFamily="sans-serif"
                android:paddingStart="14dp"
                android:paddingEnd="14dp" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:background="@color/md_theme_light_outline" />
        </LinearLayout>

        <!-- ==================== GOOGLE SIGN-IN ==================== -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_google_signin"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            style="@style/Widget.HealthScanner.Button.Outlined"
            android:text="  Continue with Google"
            android:textSize="15sp"
            android:textColor="@color/text_primary_light"
            app:strokeColor="@color/md_theme_light_outline"
            app:strokeWidth="1.5dp"
            app:icon="@drawable/ic_google"
            app:iconGravity="textStart"
            app:iconPadding="12dp"
            android:backgroundTint="@color/md_theme_light_surface"
            android:contentDescription="Sign in with Google" />

        <!-- ==================== SIGN-UP PROMPT ==================== -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="28dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Don't have an account? "
                android:textSize="14sp"
                android:textColor="@color/text_secondary_light"
                android:fontFamily="sans-serif" />

            <TextView
                android:id="@+id/btn_signup"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sign Up"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/health_teal"
                android:fontFamily="sans-serif-medium"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Go to sign up" />
        </LinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
