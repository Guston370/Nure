<?xml version="1.0" encoding="utf-8"?>
<!-- Premium Glassmorphism Bottom Navigation Bar — Floating Pill with 5 Tabs -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:paddingHorizontal="16dp"
    android:paddingBottom="16dp"
    android:paddingTop="0dp">

    <!-- Floating glass nav pill -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/navContainer"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:background="@drawable/bg_glass_nav_bar"
        android:elevation="12dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- 5-column horizontal layout for tabs -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:weightSum="5"
            android:gravity="center_vertical"
            android:clipChildren="false"
            android:clipToPadding="false"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <!-- Home Tab -->
            <LinearLayout
                android:id="@+id/navHome"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:layout_marginHorizontal="2dp"
                android:orientation="vertical"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless">

                <ImageView
                    android:id="@+id/navHomeIcon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_home"
                    android:contentDescription="Home"
                    app:tint="@color/text_secondary_light" />

                <TextView
                    android:id="@+id/navHomeLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Home"
                    android:textSize="10sp"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/text_secondary_light"
                    android:alpha="0.65" />
            </LinearLayout>

            <!-- Search Tab -->
            <LinearLayout
                android:id="@+id/navSearch"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:layout_marginHorizontal="2dp"
                android:orientation="vertical"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless">

                <ImageView
                    android:id="@+id/navSearchIcon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_search"
                    android:contentDescription="Search"
                    app:tint="@color/text_secondary_light" />

                <TextView
                    android:id="@+id/navSearchLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Search"
                    android:textSize="10sp"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/text_secondary_light"
                    android:alpha="0.65" />
            </LinearLayout>

            <!-- Center Placeholder for Scan FAB -->
            <View
                android:id="@+id/navScanPlaceholder"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="false"
                android:focusable="false" />

            <!-- Insights Tab -->
            <LinearLayout
                android:id="@+id/navInsights"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:layout_marginHorizontal="2dp"
                android:orientation="vertical"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless">

                <ImageView
                    android:id="@+id/navInsightsIcon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_stats"
                    android:contentDescription="Insights"
                    app:tint="@color/text_secondary_light" />

                <TextView
                    android:id="@+id/navInsightsLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Insights"
                    android:textSize="10sp"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/text_secondary_light"
                    android:alpha="0.65" />
            </LinearLayout>

            <!-- Profile Tab -->
            <LinearLayout
                android:id="@+id/navProfile"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:layout_marginHorizontal="2dp"
                android:orientation="vertical"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless">

                <ImageView
                    android:id="@+id/navProfileIcon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_person"
                    android:contentDescription="Profile"
                    app:tint="@color/text_secondary_light" />
                <TextView
                    android:id="@+id/navProfileLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Profile"
                    android:textSize="10sp"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/text_secondary_light"
                    android:alpha="0.65" />
            </LinearLayout>

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Center Scan FAB — elevated and floats above navContainer -->
    <FrameLayout
        android:id="@+id/navScan"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_marginBottom="20dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        app:layout_constraintStart_toStartOf="@id/navContainer"
        app:layout_constraintEnd_toEndOf="@id/navContainer"
        app:layout_constraintBottom_toBottomOf="@id/navContainer"
        app:layout_constraintTop_toTopOf="@id/navContainer"
        app:layout_constraintVertical_bias="0.0">

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/navScanButton"
            android:layout_width="68dp"
            android:layout_height="68dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_barcode_scan"
            android:contentDescription="Scan"
            app:backgroundTint="@null"
            android:backgroundTint="@null"
            app:fabCustomSize="68dp"
            app:maxImageSize="30dp"
            app:elevation="16dp"
            app:tint="@color/white"
            android:background="@drawable/bg_glass_fab_scan" />

    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
