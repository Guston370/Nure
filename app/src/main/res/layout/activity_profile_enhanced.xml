<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:animateLayoutChanges="true"
    tools:context=".ProfileActivity">

    <!-- Top App Bar -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="0dp"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/md_theme_light_surface"
        android:elevation="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:title="Profile"
        app:titleTextColor="@color/md_theme_light_onSurface"
        app:navigationIcon="@drawable/ic_arrow_back" />

    <!-- Main Content ScrollView -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll_view"
        style="@style/Layout.HealthScanner.SafeScroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/home_background_gradient"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolbar">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:paddingBottom="90dp"
            android:padding="@dimen/spacing_md">

            <!-- Header with gradient and avatar -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/profile_header_card"
                style="@style/Widget.HealthScanner.CardView.Large"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:cardCornerRadius="20dp"
                app:cardElevation="8dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginBottom="@dimen/spacing_lg"
                android:backgroundTint="@color/md_theme_light_surface">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/spacing_xl"
                    android:background="@drawable/profile_header_gradient"
                    android:animateLayoutChanges="true">

                    <ImageView
                        android:id="@+id/profile_avatar"
                        android:layout_width="100dp"
                        android:layout_height="100dp"
                        android:layout_marginTop="-40dp"
                        android:contentDescription="Profile picture"
                        android:src="@drawable/ic_person"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        android:scaleType="centerCrop"
                        android:background="@drawable/profile_avatar_border"
                        android:elevation="6dp"
                        android:transitionName="profileAvatar" />

                    <TextView
                        android:id="@+id/user_name"
                        style="@style/TextAppearance.HealthScanner.Headline2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        app:layout_constraintTop_toBottomOf="@id/profile_avatar"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        android:textColor="@color/white"
                        tools:text="John Doe" />

                    <TextView
                        android:id="@+id/user_email"
                        style="@style/TextAppearance.HealthScanner.Body2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        app:layout_constraintTop_toBottomOf="@id/user_name"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        android:textColor="@color/semi_transparent_white"
                        tools:text="john.doe@example.com" />

                    <ImageView
                        android:id="@+id/icon_edit_profile"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:contentDescription="Edit profile"
                        android:src="@drawable/ic_edit"
                        app:tint="@color/white"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />

                </androidx.constraintlayout.widget.ConstraintLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Stats Overview Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/health_stats_card"
                style="@style/Widget.HealthScanner.CardView"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toBottomOf="@id/profile_header_card"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginBottom="@dimen/spacing_lg">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:weightSum="3"
                    android:padding="@dimen/spacing_md">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center">

                        <TextView
                            android:id="@+id/total_scans"
                            style="@style/TextAppearance.HealthScanner.Headline2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/md_theme_light_primary"
                            tools:text="42" />

                        <TextView
                            style="@style/TextAppearance.HealthScanner.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Total Scans" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center">

                        <TextView
                            android:id="@+id/healthy_choices"
                            style="@style/TextAppearance.HealthScanner.Headline2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/health_excellent"
                            tools:text="28" />

                        <TextView
                            style="@style/TextAppearance.HealthScanner.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Healthy Products" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center">

                        <TextView
                            android:id="@+id/unhealthy_products"
                            style="@style/TextAppearance.HealthScanner.Headline2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/health_unhealthy"
                            tools:text="14" />

                        <TextView
                            style="@style/TextAppearance.HealthScanner.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Unhealthy Products" />

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Saved Items Section -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/saved_items_card"
                style="@style/Widget.HealthScanner.CardView"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toBottomOf="@id/health_stats_card"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginBottom="@dimen/spacing_lg">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_md">

                    <TextView
                        style="@style/TextAppearance.HealthScanner.Headline2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Your Saved Products" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/saved_items_recycler"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false"
                        android:visibility="gone"
                        tools:itemCount="0" />

                    <LinearLayout
                        android:id="@+id/empty_state_saved"
                        style="@style/Widget.HealthScanner.EmptyState"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="visible">

                        <ImageView
                            android:layout_width="64dp"
                            android:layout_height="64dp"
                            android:layout_marginBottom="@dimen/spacing_md"
                            android:alpha="0.6"
                            android:contentDescription="No saved items"
                            android:src="@drawable/ic_bookmark"
                            app:tint="@color/md_theme_light_onSurfaceVariant" />

                        <TextView
                            style="@style/TextAppearance.HealthScanner.Body1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="@dimen/spacing_sm"
                            android:text="No saved products yet"
                            android:textStyle="bold" />

                        <TextView
                            style="@style/TextAppearance.HealthScanner.Body2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Start scanning to save healthy products"
                            android:textAlignment="center" />

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Preferences / Settings Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/settings_card"
                style="@style/Widget.HealthScanner.CardView"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toBottomOf="@id/saved_items_card"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginBottom="@dimen/spacing_lg">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_md">

                    <!-- Edit Profile -->
                    <LinearLayout
                        android:id="@+id/edit_profile_setting"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/list_item_height_medium"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="@dimen/spacing_md">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_marginEnd="@dimen/spacing_md"
                            android:contentDescription="Edit Profile"
                            android:src="@drawable/ic_edit"
                            app:tint="@color/md_theme_light_onSurfaceVariant" />

                        <TextView
                            style="@style/TextAppearance.HealthScanner.Body1"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Edit Profile" />

                    </LinearLayout>

                    <View style="@style/Widget.HealthScanner.Divider" />

                    <!-- Dark Mode Toggle -->
                    <LinearLayout
                        android:id="@+id/dark_mode_setting"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/list_item_height_medium"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="@dimen/spacing_md">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_marginEnd="@dimen/spacing_md"
                            android:contentDescription="Dark Mode"
                            android:src="@drawable/ic_dark_mode"
                            app:tint="@color/md_theme_light_onSurfaceVariant" />

                        <TextView
                            style="@style/TextAppearance.HealthScanner.Body1"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Dark Mode" />

                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/switch_dark_mode"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />

                    </LinearLayout>

                    <View style="@style/Widget.HealthScanner.Divider" />

                    <!-- Settings -->
                    <LinearLayout
                        android:id="@+id/settings_option"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/list_item_height_medium"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="@dimen/spacing_md">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_marginEnd="@dimen/spacing_md"
                            android:contentDescription="Settings"
                            android:src="@drawable/ic_settings"
                            app:tint="@color/md_theme_light_onSurfaceVariant" />

                        <TextView
                            style="@style/TextAppearance.HealthScanner.Body1"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Settings" />

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/ic_arrow_forward"
                            android:contentDescription="Go to Settings"
                            app:tint="@color/health_text_secondary" />

                    </LinearLayout>

                    <View style="@style/Widget.HealthScanner.Divider" />

                    <!-- Contact Support -->
                    <LinearLayout
                        android:id="@+id/contact_support"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/list_item_height_medium"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="@dimen/spacing_md">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_marginEnd="@dimen/spacing_md"
                            android:contentDescription="Contact Support"
                            android:src="@drawable/ic_support"
                            app:tint="@color/md_theme_light_onSurfaceVariant" />

                        <TextView
                            style="@style/TextAppearance.HealthScanner.Body1"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Contact Support" />

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Logout Button (keep id references used elsewhere) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/logout_button"
                style="@style/Widget.HealthScanner.Button.Outlined"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height_medium"
                app:layout_constraintTop_toBottomOf="@id/settings_card"
                android:layout_marginTop="@dimen/spacing_md"
                android:text="Logout"
                android:textColor="@color/md_theme_light_error"
                app:strokeColor="@color/md_theme_light_error" />

            <!-- Footer Text -->
            <TextView
                android:id="@+id/profile_footer"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_lg"
                android:layout_marginBottom="@dimen/spacing_xxxl"
                android:text="Nure © 2025 — Eat Smart, Live Better"
                android:textColor="@color/md_theme_light_onSurfaceVariant"
                android:textAlignment="center"
                app:layout_constraintTop_toBottomOf="@id/logout_button"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- Floating Action Button for Edit Profile -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/edit_profile_fab"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/spacing_lg"
        android:src="@drawable/ic_edit"
        android:contentDescription="Edit Profile"
        android:backgroundTint="@color/health_teal"
        app:tint="@color/white"
        app:elevation="@dimen/elevation_lg"
        app:borderWidth="0dp"
        app:layout_constraintBottom_toTopOf="@+id/classy_navbar_container"
        app:layout_constraintEnd_toEndOf="parent"
        android:animation="@anim/scale_bounce" />

    <!-- Classy Bottom Navigation -->
    <include layout="@layout/bottom_nav_classy" />

    <!-- Animation Overlay Container for Circular Reveal -->
    <include layout="@layout/animation_overlay_container" />

</androidx.constraintlayout.widget.ConstraintLayout>