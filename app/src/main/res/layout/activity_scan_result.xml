<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/health_gradient_background"
    android:animateLayoutChanges="true"
    tools:context=".ScanResultActivity">

    <!-- Top App Bar -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="0dp"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/md_theme_light_surface"
        android:elevation="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:title="Scan Result"
        app:titleTextColor="@color/md_theme_light_onSurface"
        app:navigationIcon="@drawable/ic_arrow_back" />

    <!-- Main Content ScrollView -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll_view"
        style="@style/Layout.HealthScanner.SafeScroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolbar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/spacing_md">

            <!-- Product Header Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/product_header_card"
                style="@style/Widget.HealthScanner.CardView.Large"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_lg">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="@dimen/spacing_lg">

                    <!-- Product Image -->
                    <ImageView
                        android:id="@+id/product_image"
                        android:layout_width="@dimen/avatar_size_xlarge"
                        android:layout_height="@dimen/avatar_size_xlarge"
                        android:layout_marginEnd="@dimen/spacing_md"
                        android:background="@drawable/card_background_elevated"
                        android:contentDescription="Product Image"
                        android:scaleType="centerCrop"
                        tools:src="@drawable/ic_nutrition_facts" />

                    <!-- Product Info -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/product_name"
                            style="@style/TextAppearance.HealthScanner.Headline2"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="@dimen/spacing_xs"
                            tools:text="Organic Whole Grain Cereal" />

                        <TextView
                            android:id="@+id/brand_name"
                            style="@style/TextAppearance.HealthScanner.Body2"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="@dimen/spacing_sm"
                            tools:text="Nature's Best" />

                        <!-- Save Button -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_save_product"
                            style="@style/Widget.HealthScanner.Button.Secondary"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Save"
                            app:icon="@drawable/ic_favorite"
                            app:iconGravity="textStart" />

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>      
      <!-- Health Score Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/health_score_card"
                style="@style/Widget.HealthScanner.CardView.Large"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_lg">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_xl">

                    <TextView
                        style="@style/TextAppearance.HealthScanner.Headline2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/spacing_lg"
                        android:text="Health Score" />

                    <!-- Health Score Circle -->
                    <FrameLayout
                        android:layout_width="@dimen/health_score_size"
                        android:layout_height="@dimen/health_score_size"
                        android:layout_marginBottom="@dimen/spacing_md">

                        <com.google.android.material.progressindicator.CircularProgressIndicator
                            android:id="@+id/health_score_progress"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_gravity="center"
                            android:progress="75"
                            app:indicatorColor="@color/health_good"
                            app:indicatorSize="@dimen/health_score_size"
                            app:trackColor="@color/md_theme_light_surfaceVariant"
                            app:trackThickness="@dimen/health_score_stroke_width"
                            tools:progress="75" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:gravity="center"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/health_score_text"
                                style="@style/TextAppearance.HealthScanner.Headline1"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textStyle="bold"
                                tools:text="B+" />

                            <TextView
                                android:id="@+id/health_score_description"
                                style="@style/TextAppearance.HealthScanner.Caption"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                tools:text="Good Choice" />

                        </LinearLayout>

                    </FrameLayout>

                    <!-- Health Score Explanation -->
                    <TextView
                        android:id="@+id/health_score_explanation"
                        style="@style/TextAppearance.HealthScanner.Body2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAlignment="center"
                        tools:text="This product has moderate sugar content but good protein levels." />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Nutrition Facts Section -->
            <TextView
                style="@style/TextAppearance.HealthScanner.Headline2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_md"
                android:text="Nutrition Facts" />

            <!-- Nutrition Cards Grid -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_md"
                android:orientation="horizontal"
                android:weightSum="2">

                <!-- Calories Card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/calories_card"
                    style="@style/Widget.HealthScanner.CardView.Nutrition"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/nutrition_card_height"
                    android:layout_marginEnd="@dimen/spacing_sm"
                    android:layout_weight="1">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="@dimen/spacing_md">

                        <ImageView
                            android:layout_width="@dimen/nutrition_icon_size"
                            android:layout_height="@dimen/nutrition_icon_size"
                            android:layout_marginBottom="@dimen/spacing_sm"
                            android:contentDescription="Calories"
                            android:src="@drawable/ic_calories"
                            app:tint="@color/calories_color" />

                        <TextView
                            android:id="@+id/calories_value"
                            style="@style/TextAppearance.HealthScanner.Headline2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/calories_color"
                            tools:text="150" />

                        <TextView
                            style="@style/TextAppearance.HealthScanner.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Calories" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- Sugar Card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/sugar_card"
                    style="@style/Widget.HealthScanner.CardView.Nutrition"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/nutrition_card_height"
                    android:layout_marginStart="@dimen/spacing_sm"
                    android:layout_weight="1">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="@dimen/spacing_md">

                        <ImageView
                            android:layout_width="@dimen/nutrition_icon_size"
                            android:layout_height="@dimen/nutrition_icon_size"
                            android:layout_marginBottom="@dimen/spacing_sm"
                            android:contentDescription="Sugar"
                            android:src="@drawable/ic_sugar"
                            app:tint="@color/sugar_color" />

                        <TextView
                            android:id="@+id/sugar_value"
                            style="@style/TextAppearance.HealthScanner.Headline2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/sugar_color"
                            tools:text="3g" />

                        <TextView
                            style="@style/TextAppearance.HealthScanner.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Sugar" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>          
  <!-- Second Row of Nutrition Cards -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_lg"
                android:orientation="horizontal"
                android:weightSum="2">

                <!-- Protein Card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/protein_card"
                    style="@style/Widget.HealthScanner.CardView.Nutrition"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/nutrition_card_height"
                    android:layout_marginEnd="@dimen/spacing_sm"
                    android:layout_weight="1">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="@dimen/spacing_md">

                        <ImageView
                            android:layout_width="@dimen/nutrition_icon_size"
                            android:layout_height="@dimen/nutrition_icon_size"
                            android:layout_marginBottom="@dimen/spacing_sm"
                            android:contentDescription="Protein"
                            android:src="@drawable/ic_protein"
                            app:tint="@color/protein_color" />

                        <TextView
                            android:id="@+id/protein_value"
                            style="@style/TextAppearance.HealthScanner.Headline2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/protein_color"
                            tools:text="8g" />

                        <TextView
                            style="@style/TextAppearance.HealthScanner.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Protein" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- Sodium Card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/sodium_card"
                    style="@style/Widget.HealthScanner.CardView.Nutrition"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/nutrition_card_height"
                    android:layout_marginStart="@dimen/spacing_sm"
                    android:layout_weight="1">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="@dimen/spacing_md">

                        <ImageView
                            android:layout_width="@dimen/nutrition_icon_size"
                            android:layout_height="@dimen/nutrition_icon_size"
                            android:layout_marginBottom="@dimen/spacing_sm"
                            android:contentDescription="Sodium"
                            android:src="@drawable/ic_salt"
                            app:tint="@color/sodium_color" />

                        <TextView
                            android:id="@+id/sodium_value"
                            style="@style/TextAppearance.HealthScanner.Headline2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/sodium_color"
                            tools:text="120mg" />

                        <TextView
                            style="@style/TextAppearance.HealthScanner.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Sodium" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

            <!-- Ingredients Card (Expandable) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/ingredients_card"
                style="@style/Widget.HealthScanner.CardView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_lg">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_lg">

                    <!-- Ingredients Header -->
                    <LinearLayout
                        android:id="@+id/ingredients_header"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingVertical="@dimen/spacing_sm">

                        <TextView
                            style="@style/TextAppearance.HealthScanner.Headline2"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Ingredients" />

                        <ImageView
                            android:id="@+id/ingredients_expand_icon"
                            android:layout_width="@dimen/icon_size_medium"
                            android:layout_height="@dimen/icon_size_medium"
                            android:contentDescription="Expand Ingredients"
                            android:src="@drawable/ic_expand_more"
                            app:tint="@color/md_theme_light_onSurfaceVariant" />

                    </LinearLayout>

                    <!-- Ingredients Content (Initially collapsed) -->
                    <TextView
                        android:id="@+id/ingredients_content"
                        style="@style/TextAppearance.HealthScanner.Body1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_sm"
                        android:visibility="gone"
                        tools:text="Organic whole grain oats, organic cane sugar, organic rice flour, organic sunflower oil, natural vanilla flavor, sea salt, vitamin E (mixed tocopherols)."
                        tools:visibility="visible" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Action Buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_xxxl"
                android:orientation="horizontal"
                android:weightSum="2">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_scan_another"
                    style="@style/Widget.HealthScanner.Button.Secondary"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/button_height_medium"
                    android:layout_marginEnd="@dimen/spacing_sm"
                    android:layout_weight="1"
                    android:text="Scan Another" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_view_alternatives"
                    style="@style/Widget.HealthScanner.Button.Primary"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/button_height_medium"
                    android:layout_marginStart="@dimen/spacing_sm"
                    android:layout_weight="1"
                    android:text="View Alternatives" />

            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- Loading Overlay for scan processing -->
    <FrameLayout
        android:id="@+id/loading_overlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/semi_transparent"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical">

            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:id="@+id/progress_indicator"
                style="@style/Widget.HealthScanner.ProgressBar"
                android:layout_width="@dimen/progress_size_large"
                android:layout_height="@dimen/progress_size_large"
                android:layout_marginBottom="@dimen/spacing_md"
                android:indeterminate="true" />

            <TextView
                style="@style/TextAppearance.HealthScanner.Body1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Analyzing product..."
                android:textColor="@color/white" />

        </LinearLayout>

    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>