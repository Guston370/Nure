<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="@dimen/spacing_md">

    <!-- Product Header Shimmer -->
    <com.google.android.material.card.MaterialCardView
        style="@style/Widget.HealthScanner.CardView.Large"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/spacing_lg">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="@dimen/spacing_lg">

            <!-- Product Image Shimmer -->
            <View
                style="@style/Widget.HealthScanner.Shimmer"
                android:layout_width="@dimen/avatar_size_xlarge"
                android:layout_height="@dimen/avatar_size_xlarge"
                android:layout_marginEnd="@dimen/spacing_md" />

            <!-- Product Info Shimmer -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <View
                    style="@style/Widget.HealthScanner.Shimmer.Title"
                    android:layout_width="match_parent"
                    android:layout_marginBottom="@dimen/spacing_sm" />

                <View
                    style="@style/Widget.HealthScanner.Shimmer.Text"
                    android:layout_width="200dp"
                    android:layout_marginBottom="@dimen/spacing_md" />

                <View
                    style="@style/Widget.HealthScanner.Shimmer"
                    android:layout_width="80dp"
                    android:layout_height="@dimen/button_height_small" />

            </LinearLayout>

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- Health Score Shimmer -->
    <com.google.android.material.card.MaterialCardView
        style="@style/Widget.HealthScanner.CardView.Large"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/spacing_lg">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="@dimen/spacing_xl">

            <View
                style="@style/Widget.HealthScanner.Shimmer.Title"
                android:layout_width="120dp"
                android:layout_marginBottom="@dimen/spacing_lg" />

            <!-- Health Score Circle Shimmer -->
            <View
                style="@style/Widget.HealthScanner.Shimmer"
                android:layout_width="@dimen/health_score_size"
                android:layout_height="@dimen/health_score_size"
                android:layout_marginBottom="@dimen/spacing_md"
                android:background="@drawable/shimmer_placeholder" />

            <View
                style="@style/Widget.HealthScanner.Shimmer.Text"
                android:layout_width="200dp" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- Nutrition Cards Shimmer -->
    <View
        style="@style/Widget.HealthScanner.Shimmer.Title"
        android:layout_width="150dp"
        android:layout_marginBottom="@dimen/spacing_md" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/spacing_md"
        android:orientation="horizontal"
        android:weightSum="2">

        <View
            style="@style/Widget.HealthScanner.Shimmer"
            android:layout_width="0dp"
            android:layout_height="@dimen/nutrition_card_height"
            android:layout_marginEnd="@dimen/spacing_sm"
            android:layout_weight="1" />

        <View
            style="@style/Widget.HealthScanner.Shimmer"
            android:layout_width="0dp"
            android:layout_height="@dimen/nutrition_card_height"
            android:layout_marginStart="@dimen/spacing_sm"
            android:layout_weight="1" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/spacing_lg"
        android:orientation="horizontal"
        android:weightSum="2">

        <View
            style="@style/Widget.HealthScanner.Shimmer"
            android:layout_width="0dp"
            android:layout_height="@dimen/nutrition_card_height"
            android:layout_marginEnd="@dimen/spacing_sm"
            android:layout_weight="1" />

        <View
            style="@style/Widget.HealthScanner.Shimmer"
            android:layout_width="0dp"
            android:layout_height="@dimen/nutrition_card_height"
            android:layout_marginStart="@dimen/spacing_sm"
            android:layout_weight="1" />

    </LinearLayout>

</LinearLayout>