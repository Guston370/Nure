<?xml version="1.0" encoding="utf-8"?>
<!-- Premium Glassmorphism Search Screen -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/gradient_page_background"
    tools:context=".SearchActivity">

    <!-- Header Bar -->
    <LinearLayout
        android:id="@+id/headerBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="48dp"
        android:paddingBottom="12dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/btn_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_arrow_back"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:padding="12dp"
            app:tint="#FFF8FAFC"
            android:contentDescription="Back" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="Explore Foods"
            android:textAppearance="@style/TextAppearance.Material3.TitleLarge"
            android:textColor="#FFF8FAFC"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- Search Input Area -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/searchBarCard"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="8dp"
        app:cardCornerRadius="28dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="@android:color/transparent"
        app:strokeWidth="0dp"
        android:background="@drawable/bg_smoked_glass_card"
        app:layout_constraintTop_toBottomOf="@id/headerBar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_search"
                app:tint="#FF94A3B8"
                android:contentDescription="Search Icon" />

            <EditText
                android:id="@+id/et_search_query"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:background="@android:color/transparent"
                android:hint="Type brand or product name..."
                android:textColorHint="#FF475569"
                android:textColor="#FFF8FAFC"
                android:textSize="16sp"
                android:maxLines="1"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:importantForAutofill="no" />

            <ImageView
                android:id="@+id/btn_clear_search"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_close"
                app:tint="#FF94A3B8"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:padding="6dp"
                android:visibility="gone"
                android:contentDescription="Clear search" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- Horizontal Category Filter ScrollView -->
    <HorizontalScrollView
        android:id="@+id/categoryFilterScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:paddingHorizontal="16dp"
        android:clipToPadding="false"
        android:scrollbars="none"
        app:layout_constraintTop_toBottomOf="@id/searchBarCard">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Category Chips -->
            <!-- We will style these chips with glass drawables programmatically or inline -->
            <TextView
                android:id="@+id/chip_all"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="All"
                android:textColor="#FFF8FAFC"
                android:textSize="13sp"
                android:gravity="center"
                android:paddingHorizontal="16dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_nav_active_capsule"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/chip_snacks"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Snacks"
                android:textColor="#FF94A3B8"
                android:textSize="13sp"
                android:gravity="center"
                android:paddingHorizontal="16dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_smoked_glass_nav"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/chip_drinks"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Drinks"
                android:textColor="#FF94A3B8"
                android:textSize="13sp"
                android:gravity="center"
                android:paddingHorizontal="16dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_smoked_glass_nav"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/chip_dairy"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Dairy"
                android:textColor="#FF94A3B8"
                android:textSize="13sp"
                android:gravity="center"
                android:paddingHorizontal="16dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_smoked_glass_nav"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/chip_bakery"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Bakery"
                android:textColor="#FF94A3B8"
                android:textSize="13sp"
                android:gravity="center"
                android:paddingHorizontal="16dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_smoked_glass_nav"
                android:clickable="true"
                android:focusable="true" />

        </LinearLayout>

    </HorizontalScrollView>

    <!-- Search Results / States Area -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="90dp"
        app:layout_constraintTop_toBottomOf="@id/categoryFilterScroll"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- Recycler View -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/searchResultRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingTop="4dp"
            android:clipToPadding="false"
            android:visibility="gone" />

        <!-- Empty / Welcome State -->
        <LinearLayout
            android:id="@+id/emptyStateContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="32dp">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="40dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#1AFFFFFF"
                app:strokeWidth="1dp"
                app:strokeColor="#1FFFFFFF">

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_search"
                    app:tint="@color/health_teal"
                    android:contentDescription="Search Icon" />

            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/emptyStateTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Find any food item"
                android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                android:textColor="#FFF8FAFC"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/emptyStateMessage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Type in the search bar above to query global food databases"
                android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                android:textColor="#FF94A3B8"
                android:textAlignment="center" />

        </LinearLayout>

        <!-- Loading Spinner -->
        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:id="@+id/progress_search"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone"
            app:indicatorColor="@color/health_teal"
            app:trackColor="#1FFFFFFF" />

    </FrameLayout>

    <!-- Floating bottom navigation pill -->
    <include
        android:id="@+id/bottomNavBar"
        layout="@layout/bottom_nav_classy"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
