<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    tools:context=".VerticalScannerActivity">

    <!-- Camera Preview (Full Screen) -->
    <androidx.camera.view.PreviewView
        android:id="@+id/camera_preview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Simple Top Bar -->
    <LinearLayout
        android:id="@+id/top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:paddingTop="40dp"
        android:background="@drawable/simple_top_gradient"
        android:gravity="center_vertical"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Back Button -->
        <ImageView
            android:id="@+id/back_button"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_arrow_back"
            android:contentDescription="Back"
            android:background="@drawable/simple_button_background"
            android:padding="8dp"
            app:tint="@color/white" />

        <!-- Title -->
        <TextView
            android:id="@+id/scanner_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Scan Product"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold"
            android:gravity="center" />

        <!-- Flash Button -->
        <ImageView
            android:id="@+id/flash_toggle"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_flash_off"
            android:contentDescription="Toggle Flash"
            android:background="@drawable/simple_button_background"
            android:padding="8dp"
            app:tint="@color/white" />

    </LinearLayout>

    <!-- Mode Toggle (Barcode / Detect Product) -->
    <LinearLayout
        android:id="@+id/mode_toggle_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="8dp"
        android:padding="4dp"
        android:background="@drawable/simple_text_background"
        app:layout_constraintTop_toBottomOf="@+id/top_bar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/mode_barcode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔍 Barcode"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:textStyle="bold"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:background="@drawable/mode_toggle_active" />

        <TextView
            android:id="@+id/mode_detect"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📷 Detect Product"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/mode_toggle_inactive" />

    </LinearLayout>

    <!-- Simple Scanning Frame (shown in barcode mode) -->
    <View
        android:id="@+id/scanning_frame"
        android:layout_width="280dp"
        android:layout_height="200dp"
        android:background="@drawable/simple_scanning_frame"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Scanning Line (barcode mode only) -->
    <View
        android:id="@+id/scanning_line"
        android:layout_width="260dp"
        android:layout_height="2dp"
        android:background="@color/primary_teal"
        app:layout_constraintTop_toTopOf="@+id/scanning_frame"
        app:layout_constraintStart_toStartOf="@+id/scanning_frame"
        app:layout_constraintEnd_toEndOf="@+id/scanning_frame" />

    <!-- Crosshair / Center indicator (shown in detect mode) -->
    <ImageView
        android:id="@+id/detect_crosshair"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:src="@drawable/simple_scanning_frame"
        android:visibility="gone"
        android:alpha="0.7"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Instructions -->
    <TextView
        android:id="@+id/instructions_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Position barcode in the frame"
        android:textColor="@color/white"
        android:textSize="16sp"
        android:background="@drawable/simple_text_background"
        android:padding="12dp"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toBottomOf="@+id/scanning_frame"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Simple Bottom Controls -->
    <LinearLayout
        android:id="@+id/bottom_controls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="24dp"
        android:gravity="center"
        android:background="@drawable/simple_bottom_gradient"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- Gallery Button -->
        <androidx.cardview.widget.CardView
            android:id="@+id/gallery_button"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginEnd="16dp"
            app:cardCornerRadius="28dp"
            app:cardElevation="8dp"
            app:cardBackgroundColor="@color/white">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_gallery"
                android:contentDescription="Gallery"
                app:tint="@color/primary_teal" />

        </androidx.cardview.widget.CardView>

        <!-- Camera Capture Button (center, larger) -->
        <androidx.cardview.widget.CardView
            android:id="@+id/camera_capture_button"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            app:cardCornerRadius="36dp"
            app:cardElevation="12dp"
            app:cardBackgroundColor="@color/primary_teal">

            <ImageView
                android:id="@+id/capture_button_icon"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_photo_capture"
                android:contentDescription="Take Photo"
                app:tint="@color/white" />

        </androidx.cardview.widget.CardView>

        <!-- Manual Entry Button -->
        <androidx.cardview.widget.CardView
            android:id="@+id/manual_entry_button"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginStart="16dp"
            app:cardCornerRadius="28dp"
            app:cardElevation="8dp"
            app:cardBackgroundColor="@color/white">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_keyboard"
                android:contentDescription="Manual Entry"
                app:tint="@color/primary_teal" />

        </androidx.cardview.widget.CardView>

    </LinearLayout>

    <!-- Scan Status -->
    <androidx.cardview.widget.CardView
        android:id="@+id/scan_status_card"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        android:layout_marginBottom="16dp"
        android:visibility="gone"
        app:cardCornerRadius="16dp"
        app:cardElevation="12dp"
        app:cardBackgroundColor="@color/primary_teal"
        app:layout_constraintBottom_toTopOf="@+id/bottom_controls"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="16dp"
            android:gravity="center_vertical">

            <ProgressBar
                android:id="@+id/scan_progress"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:indeterminateTint="@color/white"
                android:layout_marginEnd="12dp" />

            <TextView
                android:id="@+id/scan_status_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Scanning..."
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold" />

        </LinearLayout>

    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>