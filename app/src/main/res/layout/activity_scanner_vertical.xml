<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dark_navy_deep"
    tools:context=".VerticalScannerActivity">

    <!-- Camera Preview (Full Screen) -->
    <androidx.camera.view.PreviewView
        android:id="@+id/camera_preview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Darkened Overlay with cutout -->
    <com.example.healthscanner.ScannerOverlayView
        android:id="@+id/scanner_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Enhanced Overlay Container -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/transparent">

        <!-- Modern Top Bar with Gradient -->
        <LinearLayout
            android:id="@+id/top_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="52dp"
            android:paddingBottom="12dp"
            android:background="@drawable/scanner_top_gradient_enhanced"
            android:gravity="center_vertical"
            android:elevation="12dp"
            app:layout_constraintTop_toTopOf="parent">

            <!-- Enhanced Back Button -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="48dp"
                android:layout_height="48dp"
                app:cardCornerRadius="24dp"
                app:cardElevation="12dp"
                app:strokeWidth="1dp"
                app:strokeColor="#1FFFFFFF"
                app:cardBackgroundColor="#BF141419">

                <ImageView
                    android:id="@+id/back_button"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_arrow_back"
                    android:contentDescription="Back"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    app:tint="@color/white" />

            </com.google.android.material.card.MaterialCardView>

            <!-- Simplified Title -->
            <TextView
                android:id="@+id/scanner_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="NURE SCAN"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:textStyle="bold"
                android:letterSpacing="0.15"
                android:gravity="center"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp" />

            <!-- Enhanced Flash Toggle -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="48dp"
                android:layout_height="48dp"
                app:cardCornerRadius="24dp"
                app:cardElevation="12dp"
                app:strokeWidth="1dp"
                app:strokeColor="#1FFFFFFF"
                app:cardBackgroundColor="#BF141419">

                <ImageView
                    android:id="@+id/flash_toggle"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_flash_off"
                    android:contentDescription="Toggle Flash"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    app:tint="@color/white" />

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

        <!-- Mode Toggle (Barcode / Detect Product) -->
        <LinearLayout
            android:id="@+id/mode_toggle_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="20dp"
            android:padding="6dp"
            android:background="@drawable/bg_glass_search_bar"
            app:layout_constraintTop_toBottomOf="@+id/top_bar"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:id="@+id/mode_barcode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔍 Barcode"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:textStyle="bold"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:background="@drawable/mode_toggle_active" />

            <TextView
                android:id="@+id/mode_detect"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📷 Detect Product"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:layout_marginStart="4dp"
                android:background="@drawable/mode_toggle_inactive" />

        </LinearLayout>

        <!-- Premium Horizontal Scanning Frame -->
        <androidx.cardview.widget.CardView
            android:id="@+id/scanning_frame_card"
            android:layout_width="0dp"
            android:layout_height="180dp"
            android:layout_marginTop="20dp"
            app:cardCornerRadius="32dp"
            app:cardElevation="20dp"
            app:cardBackgroundColor="@color/transparent"
            app:layout_constraintWidth_percent="0.85"
            app:layout_constraintTop_toBottomOf="@+id/mode_toggle_container"
            app:layout_constraintBottom_toTopOf="@+id/bottom_controls"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/scanning_frame_container"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <!-- Premium Scanning Frame Background -->
                <View
                    android:id="@+id/scanning_frame"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/premium_scanning_frame" />

                <!-- Animated Corner Indicators -->
                <ImageView
                    android:id="@+id/corner_tl"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/ic_scan_corner_premium"
                    android:rotation="0"
                    android:layout_margin="12dp"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:tint="@color/health_teal" />

                <ImageView
                    android:id="@+id/corner_tr"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/ic_scan_corner_premium"
                    android:rotation="90"
                    android:layout_margin="12dp"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:tint="@color/health_teal" />

                <ImageView
                    android:id="@+id/corner_bl"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/ic_scan_corner_premium"
                    android:rotation="270"
                    android:layout_margin="12dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:tint="@color/health_teal" />

                <ImageView
                    android:id="@+id/corner_br"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/ic_scan_corner_premium"
                    android:rotation="180"
                    android:layout_margin="12dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:tint="@color/primary_teal" />

                <!-- Premium Scanning Line with Glow -->
                <View
                    android:id="@+id/scanning_line"
                    android:layout_width="match_parent"
                    android:layout_height="4dp"
                    android:background="@drawable/premium_scanning_line"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    android:elevation="8dp"
                    app:layout_constraintTop_toTopOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.cardview.widget.CardView>

        <!-- Crosshair / Center indicator (shown in detect mode) -->
        <ImageView
            android:id="@+id/detect_crosshair"
            android:layout_width="160dp"
            android:layout_height="160dp"
            android:src="@drawable/simple_scanning_frame"
            android:visibility="gone"
            android:alpha="0.7"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:tint="@color/nure_primary" />

        <!-- Enhanced Instructions -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/instructions_card"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="40dp"
            android:layout_marginEnd="40dp"
            android:layout_marginTop="24dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="12dp"
            app:strokeWidth="1dp"
            app:strokeColor="#1FFFFFFF"
            app:cardBackgroundColor="#BF141419"
            app:layout_constraintTop_toBottomOf="@+id/scanning_frame_card"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="20dp">

                <TextView
                    android:id="@+id/instructions_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Position barcode within the frame"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:gravity="center" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Hold steady for automatic detection"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:alpha="0.9"
                    android:gravity="center"
                    android:layout_marginTop="6dp" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Premium Bottom Controls -->
        <LinearLayout
            android:id="@+id/bottom_controls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="32dp"
            android:gravity="center"
            android:background="@drawable/scanner_bottom_gradient_enhanced"
            android:elevation="12dp"
            app:layout_constraintBottom_toBottomOf="parent">

            <!-- Enhanced Controls Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginBottom="20dp">

                <!-- Gallery Button -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/gallery_button"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:layout_marginEnd="16dp"
                    app:cardCornerRadius="32dp"
                    app:cardElevation="12dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="#1FFFFFFF"
                    app:cardBackgroundColor="#BF141419">

                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_gallery"
                        android:contentDescription="Select from Gallery"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        app:tint="@color/health_teal" />

                </com.google.android.material.card.MaterialCardView>

                <!-- Camera Capture Button (center, larger) -->
                <FrameLayout
                    android:id="@+id/camera_capture_button"
                    android:layout_width="76dp"
                    android:layout_height="76dp"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    android:background="@drawable/bg_smoked_glass_button_primary"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:clipToOutline="true">

                    <ImageView
                        android:id="@+id/capture_button_icon"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_photo_capture"
                        android:contentDescription="Take Photo"
                        app:tint="@color/white" />

                </FrameLayout>

                <!-- Manual Entry Button -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/manual_entry_button"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:layout_marginStart="16dp"
                    app:cardCornerRadius="32dp"
                    app:cardElevation="12dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="#1FFFFFFF"
                    app:cardBackgroundColor="#BF141419">

                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_keyboard"
                        android:contentDescription="Manual Entry"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        app:tint="@color/health_teal" />

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

            <!-- Enhanced Help Text -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Gallery • Manual Entry"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:alpha="0.8"
                android:gravity="center" />

        </LinearLayout>

        <!-- Enhanced Scan Status -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/scan_status_card"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="40dp"
            android:layout_marginEnd="40dp"
            android:layout_marginBottom="20dp"
            android:visibility="gone"
            app:cardCornerRadius="20dp"
            app:cardElevation="16dp"
            app:strokeWidth="1.5dp"
            app:strokeColor="@color/health_teal"
            app:cardBackgroundColor="#E1141419"
            app:layout_constraintBottom_toTopOf="@+id/bottom_controls"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="20dp"
                android:gravity="center_vertical">

                <ProgressBar
                    android:id="@+id/scan_progress"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:indeterminateTint="@color/health_teal"
                    android:layout_marginEnd="16dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/scan_status_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Analyzing Product..."
                        android:textColor="@color/white"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/scan_status_subtext"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Getting health information"
                        android:textColor="@color/white"
                        android:textSize="12sp"
                        android:alpha="0.9"
                        android:layout_marginTop="2dp" />

                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Premium Product Preview Card (shown on successful detection) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/product_preview_card"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            android:layout_marginBottom="20dp"
            android:visibility="gone"
            app:cardCornerRadius="24dp"
            app:cardElevation="16dp"
            app:strokeWidth="1.5dp"
            app:strokeColor="@color/health_teal"
            app:cardBackgroundColor="#E1141419"
            app:layout_constraintBottom_toTopOf="@+id/bottom_controls"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/preview_image_container"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    app:cardCornerRadius="16dp"
                    app:cardBackgroundColor="#20FFFFFF"
                    app:strokeWidth="0dp">

                    <ImageView
                        android:id="@+id/preview_product_image"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:src="@drawable/ic_product_placeholder" />

                </com.google.android.material.card.MaterialCardView>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_toEndOf="@id/preview_image_container"
                    android:layout_toStartOf="@+id/preview_score_container"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    android:layout_centerVertical="true"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/preview_product_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Loading product..."
                        android:textColor="@color/white"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:ellipsize="end"
                        android:maxLines="1" />

                    <TextView
                        android:id="@+id/preview_product_brand"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Please wait"
                        android:textColor="@color/text_secondary"
                        android:textSize="14sp"
                        android:layout_marginTop="4dp"
                        android:ellipsize="end"
                        android:maxLines="1" />

                </LinearLayout>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/preview_score_container"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp"
                    app:cardBackgroundColor="@color/primary_teal">

                    <TextView
                        android:id="@+id/preview_product_score"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="—"
                        android:textColor="@color/white"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:paddingTop="6dp"
                        android:paddingBottom="6dp" />

                </com.google.android.material.card.MaterialCardView>

            </RelativeLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Simplified - No overlay, direct navigation to product details -->

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>