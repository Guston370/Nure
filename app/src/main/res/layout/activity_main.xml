<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/health_bg_light">

    <!-- Bottom Navigation Bar -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_navigation"
        android:layout_width="0dp"
        android:layout_height="@dimen/bottom_nav_height"
        android:background="@color/health_bg_card"
        android:elevation="@dimen/elevation_lg"
        app:menu="@menu/bottom_nav_menu"
        app:itemIconTint="@color/bottom_nav_color_selector"
        app:itemTextColor="@color/bottom_nav_color_selector"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Main Content Area -->
    <ScrollView
        android:id="@+id/main_content"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/health_bg_light"
        android:padding="@dimen/spacing_md"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottom_navigation"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/spacing_sm">

            <!-- Daily Nutrition Tracker Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/nutritionTrackerCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_lg"
                app:cardCornerRadius="@dimen/corner_radius_xl"
                app:cardElevation="@dimen/elevation_md"
                app:cardBackgroundColor="@color/health_bg_card">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/card_padding">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📊 Today's Nutrition"
                        android:textSize="@dimen/text_size_lg"
                        android:textColor="@color/health_text_primary"
                        android:fontFamily="sans-serif-medium"
                        android:textStyle="bold"
                        android:layout_marginBottom="@dimen/spacing_lg" />

                    <!-- Calories Progress -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="@dimen/spacing_sm">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Calories"
                            android:textSize="@dimen/text_size_sm"
                            android:textColor="@color/health_text_secondary" />

                        <TextView
                            android:id="@+id/caloriesProgress"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="1,320 / 2,000"
                            android:textSize="18sp"
                            android:textColor="@color/calories_color"
                            android:fontFamily="sans-serif-medium"
                            android:textStyle="bold" />

                    </LinearLayout>

                    <ProgressBar
                        android:id="@+id/caloriesProgressBar"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="8dp"
                        android:progress="66"
                        android:progressTint="@color/calories_color"
                        android:progressBackgroundTint="@color/scan_inactive"
                        android:layout_marginBottom="@dimen/spacing_lg" />

                    <!-- Sugar Progress -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="@dimen/spacing_sm">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Sugar"
                            android:textSize="@dimen/text_size_sm"
                            android:textColor="@color/health_text_secondary" />

                        <TextView
                            android:id="@+id/sugarProgress"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="45g / 50g"
                            android:textSize="18sp"
                            android:textColor="@color/sugar_color"
                            android:fontFamily="sans-serif-medium"
                            android:textStyle="bold" />

                    </LinearLayout>

                    <ProgressBar
                        android:id="@+id/sugarProgressBar"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="8dp"
                        android:progress="90"
                        android:progressTint="@color/sugar_color"
                        android:progressBackgroundTint="@color/scan_inactive"
                        android:layout_marginBottom="@dimen/spacing_lg" />

                    <!-- Protein Progress -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="@dimen/spacing_sm">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Protein"
                            android:textSize="@dimen/text_size_sm"
                            android:textColor="@color/health_text_secondary" />

                        <TextView
                            android:id="@+id/proteinProgress"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="65g / 100g"
                            android:textSize="18sp"
                            android:textColor="@color/protein_color"
                            android:fontFamily="sans-serif-medium"
                            android:textStyle="bold" />

                    </LinearLayout>

                    <ProgressBar
                        android:id="@+id/proteinProgressBar"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="8dp"
                        android:progress="65"
                        android:progressTint="@color/protein_color"
                        android:progressBackgroundTint="@color/scan_inactive" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Scan Section -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/scanSectionCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_xl"
                app:cardCornerRadius="@dimen/corner_radius_xxl"
                app:cardElevation="@dimen/elevation_lg"
                app:cardBackgroundColor="@color/health_bg_card">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_xxl"
                    android:gravity="center">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Scan to Discover"
                        android:textSize="@dimen/text_size_headline"
                        android:textColor="@color/health_text_primary"
                        android:fontFamily="sans-serif-medium"
                        android:layout_marginBottom="@dimen/spacing_sm" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Point your camera at any product barcode"
                        android:textSize="@dimen/text_size_md"
                        android:textColor="@color/health_text_secondary"
                        android:gravity="center"
                        android:layout_marginBottom="@dimen/spacing_xl" />

                    <!-- Scan Icon -->
                    <FrameLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/spacing_xl">

                        <ImageView
                            android:id="@+id/scanIcon"
                            android:layout_width="@dimen/scan_button_size"
                            android:layout_height="@dimen/scan_button_size"
                            android:background="@drawable/scan_button_background"
                            android:clickable="true"
                            android:focusable="true"
                            android:padding="@dimen/spacing_xl"
                            android:src="@drawable/ic_barcode_scan"
                            app:tint="@color/white" />

                        <ImageView
                            android:id="@+id/scanningIndicator"
                            android:layout_width="140dp"
                            android:layout_height="140dp"
                            android:src="@drawable/scanning_animation"
                            android:visibility="gone"
                            android:layout_gravity="center" />

                    </FrameLayout>

                    <!-- Scan Button -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/scanBtn"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/button_height_large"
                        android:text="Start Scanning"
                        android:textSize="@dimen/text_size_lg"
                        android:fontFamily="sans-serif-medium"
                        android:textAllCaps="false"
                        android:backgroundTint="@color/nure_primary"
                        android:textColor="@color/white"
                        app:cornerRadius="@dimen/corner_radius_lg"
                        android:elevation="@dimen/elevation_sm"
                        android:layout_marginBottom="@dimen/spacing_md" />

                    <!-- Scan Status Text -->
                    <TextView
                        android:id="@+id/scanStatusText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Instant nutrition analysis for any product"
                        android:textSize="@dimen/text_size_sm"
                        android:textColor="@color/health_text_hint"
                        android:gravity="center" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Manual Search Section -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_xl"
                app:cardCornerRadius="@dimen/corner_radius_lg"
                app:cardElevation="@dimen/elevation_sm"
                app:cardBackgroundColor="@color/health_bg_card">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/card_padding">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🔍 Manual Search"
                        android:textSize="@dimen/text_size_lg"
                        android:textColor="@color/health_text_primary"
                        android:fontFamily="sans-serif-medium"
                        android:textStyle="bold"
                        android:layout_marginBottom="@dimen/spacing_lg" />

                    <!-- Manual Barcode Input -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Enter barcode number"
                        android:layout_marginBottom="@dimen/spacing_lg"
                        app:boxStrokeColor="@color/nure_primary"
                        app:hintTextColor="@color/nure_primary"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/manualBarcodeInput"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="number"
                            android:textSize="@dimen/text_size_lg"
                            android:textColor="@color/health_text_primary"
                            android:maxLength="13" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/manualSearchBtn"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/button_height"
                        android:text="Search Product"
                        android:textSize="@dimen/text_size_lg"
                        android:fontFamily="sans-serif-medium"
                        android:textAllCaps="false"
                        android:textColor="@color/nure_primary"
                        app:strokeColor="@color/nure_primary"
                        app:strokeWidth="2dp"
                        style="@style/Widget.Material3.Button.OutlinedButton" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Product Result Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/resultCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_lg"
                android:visibility="gone"
                app:cardCornerRadius="@dimen/corner_radius_xl"
                app:cardElevation="@dimen/elevation_lg"
                app:cardBackgroundColor="@color/health_bg_card">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/card_padding">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📦 Product Analysis"
                        android:textSize="@dimen/text_size_lg"
                        android:textColor="@color/health_text_primary"
                        android:fontFamily="sans-serif-medium"
                        android:textStyle="bold"
                        android:layout_marginBottom="@dimen/spacing_lg" />

                    <TextView
                        android:id="@+id/productName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Product Name"
                        android:textSize="20sp"
                        android:textColor="@color/health_text_primary"
                        android:fontFamily="sans-serif-medium"
                        android:layout_marginBottom="@dimen/spacing_xs" />

                    <TextView
                        android:id="@+id/productBrand"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Brand"
                        android:textSize="@dimen/text_size_md"
                        android:textColor="@color/health_text_secondary"
                        android:layout_marginBottom="@dimen/spacing_md" />

                    <TextView
                        android:id="@+id/productIngredients"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Ingredients list will appear here"
                        android:textSize="@dimen/text_size_md"
                        android:textColor="@color/health_text_secondary"
                        android:layout_marginBottom="@dimen/spacing_lg" />

                    <!-- Nutrition Values -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="@dimen/spacing_lg">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center">

                            <TextView
                                android:id="@+id/caloriesValue"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="150"
                                android:textSize="18sp"
                                android:textColor="@color/calories_color"
                                android:fontFamily="sans-serif-medium"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="kcal"
                                android:textSize="@dimen/text_size_sm"
                                android:textColor="@color/health_text_secondary" />

                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center">

                            <TextView
                                android:id="@+id/sugarValue"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="39"
                                android:textSize="18sp"
                                android:textColor="@color/sugar_color"
                                android:fontFamily="sans-serif-medium"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="g sugar"
                                android:textSize="@dimen/text_size_sm"
                                android:textColor="@color/health_text_secondary" />

                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center">

                            <TextView
                                android:id="@+id/proteinValue"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0"
                                android:textSize="18sp"
                                android:textColor="@color/protein_color"
                                android:fontFamily="sans-serif-medium"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="g protein"
                                android:textSize="@dimen/text_size_sm"
                                android:textColor="@color/health_text_secondary" />

                        </LinearLayout>

                    </LinearLayout>

                    <!-- Secondary Nutrition -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="@dimen/spacing_lg">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center">

                            <TextView
                                android:id="@+id/fatValue"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0g"
                                android:textSize="14sp"
                                android:textColor="@color/fat_color"
                                android:fontFamily="sans-serif-medium"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Fat"
                                android:textSize="@dimen/text_size_xs"
                                android:textColor="@color/health_text_hint" />

                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center">

                            <TextView
                                android:id="@+id/carbsValue"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="39g"
                                android:textSize="14sp"
                                android:textColor="@color/carbs_color"
                                android:fontFamily="sans-serif-medium"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Carbs"
                                android:textSize="@dimen/text_size_xs"
                                android:textColor="@color/health_text_hint" />

                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center">

                            <TextView
                                android:id="@+id/saltValue"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0mg"
                                android:textSize="14sp"
                                android:textColor="@color/sodium_color"
                                android:fontFamily="sans-serif-medium"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Sodium"
                                android:textSize="@dimen/text_size_xs"
                                android:textColor="@color/health_text_hint" />

                        </LinearLayout>

                    </LinearLayout>

                    <!-- Action Buttons -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/favoriteBtn"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:src="@drawable/ic_favorite"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:padding="8dp"
                            android:layout_marginEnd="16dp"
                            app:tint="@color/nure_primary" />

                        <com.google.android.material.button.MaterialButton
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="View Details"
                            android:textSize="14sp"
                            android:textColor="@color/nure_primary"
                            app:strokeColor="@color/nure_primary"
                            app:strokeWidth="2dp"
                            style="@style/Widget.Material3.Button.OutlinedButton" />

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>