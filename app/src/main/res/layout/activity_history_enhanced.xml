<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/home_background_gradient"
    android:animateLayoutChanges="true"
    tools:context=".HistoryActivity">

    <!-- Header Section with Gradient -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/headerSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/header_gradient_background"
        android:paddingStart="@dimen/spacing_lg"
        android:paddingEnd="@dimen/spacing_lg"
        android:paddingTop="@dimen/spacing_xl"
        android:paddingBottom="@dimen/spacing_lg"
        app:layout_constraintTop_toTopOf="parent">

        <!-- History Title -->
        <TextView
            android:id="@+id/historyTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Scan History 🕒"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:alpha="0"
            android:translationY="-20dp"
            android:animation="@anim/fade_in_slide_down"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/filterIcon" />

        <!-- Subtitle -->
        <TextView
            android:id="@+id/historySubtitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Your recently scanned products and health insights"
            android:textSize="16sp"
            android:textColor="@color/white"
            android:alpha="0.9"
            android:layout_marginTop="@dimen/spacing_xs"
            app:layout_constraintTop_toBottomOf="@+id/historyTitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/filterIcon" />

        <!-- Filter/Sort Icon -->
        <ImageView
            android:id="@+id/filterIcon"
            android:layout_width="@dimen/icon_size_large"
            android:layout_height="@dimen/icon_size_large"
            android:src="@drawable/ic_filter_list"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Filter History"
            app:tint="@color/white"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Search Bar (Optional Enhancement) -->
    <androidx.cardview.widget.CardView
        android:id="@+id/searchCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/spacing_md"
        android:visibility="gone"
        app:cardCornerRadius="16dp"
        app:cardElevation="@dimen/elevation_sm"
        app:cardBackgroundColor="@color/white"
        app:layout_constraintTop_toBottomOf="@+id/headerSection"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="@dimen/spacing_md"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="@dimen/icon_size_medium"
                android:layout_height="@dimen/icon_size_medium"
                android:src="@drawable/ic_search"
                android:contentDescription="Search"
                app:tint="@color/health_text_secondary"
                android:layout_marginEnd="@dimen/spacing_sm" />

            <EditText
                android:id="@+id/searchEditText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Search your scan history..."
                android:textSize="16sp"
                android:textColor="@color/health_text_primary"
                android:textColorHint="@color/health_text_secondary"
                android:background="@android:color/transparent"
                android:inputType="text"
                android:imeOptions="actionSearch" />

        </LinearLayout>

    </androidx.cardview.widget.CardView>

    <!-- Filter Chips (Optional Enhancement) -->
    <HorizontalScrollView
        android:id="@+id/filterChipsContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_md"
        android:layout_marginEnd="@dimen/spacing_md"
        android:layout_marginBottom="@dimen/spacing_sm"
        android:visibility="gone"
        android:scrollbars="none"
        app:layout_constraintTop_toBottomOf="@+id/searchCard"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="@dimen/spacing_sm"
            android:paddingEnd="@dimen/spacing_sm">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipAll"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/spacing_sm"
                android:text="All"
                android:checked="true"
                app:chipBackgroundColor="@color/health_mint_green" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipHealthy"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/spacing_sm"
                android:text="🥦 Healthy"
                app:chipBackgroundColor="@color/health_excellent" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipModerate"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/spacing_sm"
                android:text="⚠️ Moderate"
                app:chipBackgroundColor="@color/health_moderate" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipUnhealthy"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🍫 Unhealthy"
                app:chipBackgroundColor="@color/health_unhealthy" />

        </LinearLayout>

    </HorizontalScrollView>

    <!-- History Content Container -->
    <FrameLayout
        android:id="@+id/historyContentContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@+id/filterChipsContainer"
        app:layout_constraintBottom_toTopOf="@+id/bottom_navigation"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- History RecyclerView -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/historyRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="@dimen/spacing_md"
            android:clipToPadding="false"
            android:scrollbars="vertical"
            android:scrollbarStyle="outsideOverlay"
            tools:listitem="@layout/item_history_card" />

        <!-- Loading State -->
        <LinearLayout
            android:id="@+id/loadingState"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="@dimen/spacing_xl"
            android:visibility="gone">

            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_md"
                app:indicatorColor="@color/health_teal"
                app:trackColor="@color/health_light_gray" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Loading your scan history..."
                android:textSize="16sp"
                android:textColor="@color/health_text_secondary"
                android:gravity="center" />

        </LinearLayout>

        <!-- Empty State -->
        <LinearLayout
            android:id="@+id/emptyState"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="@dimen/spacing_xl"
            android:visibility="gone">

            <!-- Empty State Illustration -->
            <ImageView
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:src="@drawable/ic_history_empty"
                android:contentDescription="No History"
                app:tint="@color/health_text_secondary"
                android:alpha="0.6"
                android:layout_marginBottom="@dimen/spacing_lg" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="No scans yet!"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="@color/health_text_primary"
                android:layout_marginBottom="@dimen/spacing_sm" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Start scanning to track your health journey"
                android:textSize="16sp"
                android:textColor="@color/health_text_secondary"
                android:gravity="center"
                android:layout_marginBottom="@dimen/spacing_lg" />

            <!-- Start Scanning Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/startScanningButton"
                style="@style/Widget.HealthScanner.Button.Gradient"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/button_height_large"
                android:text="Start Scanning"
                android:textColor="@color/white"
                android:paddingStart="@dimen/spacing_lg"
                android:paddingEnd="@dimen/spacing_lg"
                app:icon="@drawable/ic_barcode_scan"
                app:iconTint="@color/white" />

        </LinearLayout>

        <!-- Error State -->
        <LinearLayout
            android:id="@+id/errorState"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="@dimen/spacing_xl"
            android:visibility="gone">

            <ImageView
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:src="@drawable/ic_error"
                android:contentDescription="Error"
                app:tint="@color/health_unhealthy"
                android:layout_marginBottom="@dimen/spacing_md" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Unable to load history"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/health_text_primary"
                android:layout_marginBottom="@dimen/spacing_sm" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Please check your connection and try again"
                android:textSize="14sp"
                android:textColor="@color/health_text_secondary"
                android:gravity="center"
                android:layout_marginBottom="@dimen/spacing_lg" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/retryButton"
                style="@style/Widget.HealthScanner.Button.Outlined"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Retry"
                android:textColor="@color/health_teal"
                app:strokeColor="@color/health_teal"
                app:icon="@drawable/ic_refresh"
                app:iconTint="@color/health_teal" />

        </LinearLayout>

    </FrameLayout>

    <!-- Enhanced Bottom Navigation -->
    <include layout="@layout/bottom_nav_enhanced" />

    <!-- Animation Overlay Container for Circular Reveal -->
    <include layout="@layout/animation_overlay_container" />

</androidx.constraintlayout.widget.ConstraintLayout>