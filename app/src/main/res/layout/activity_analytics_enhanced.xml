<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:animateLayoutChanges="true"
    tools:context=".AnalyticsActivity">

    <!-- Main Scrollable Content -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:background="@drawable/home_background_gradient"
        android:clipToPadding="false"
        android:paddingBottom="90dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="@dimen/spacing_xxxl">

            <!-- Header Section with Gradient -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/headerSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/header_gradient_background"
                android:paddingStart="@dimen/spacing_lg"
                android:paddingEnd="@dimen/spacing_lg"
                android:paddingTop="@dimen/spacing_xl"
                android:paddingBottom="@dimen/spacing_lg">

                <!-- Analytics Title -->
                <TextView
                    android:id="@+id/analyticsTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="Your Health Insights 📈"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:alpha="0"
                    android:translationY="-20dp"
                    android:animation="@anim/fade_in_slide_down"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/refreshIcon" />

                <!-- Subtitle -->
                <TextView
                    android:id="@+id/analyticsSubtitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="Track your health journey and progress"
                    android:textSize="16sp"
                    android:textColor="@color/white"
                    android:alpha="0.9"
                    android:layout_marginTop="@dimen/spacing_xs"
                    app:layout_constraintTop_toBottomOf="@+id/analyticsTitle"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/refreshIcon" />

                <!-- Refresh Icon -->
                <ImageView
                    android:id="@+id/refreshIcon"
                    android:layout_width="@dimen/icon_size_large"
                    android:layout_height="@dimen/icon_size_large"
                    android:src="@drawable/ic_refresh"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Refresh Analytics"
                    app:tint="@color/white"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Key Metrics Cards Row -->
            <LinearLayout
                android:id="@+id/metricsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_margin="@dimen/spacing_md"
                android:weightSum="2"
                android:animation="@anim/slide_up">

                <!-- Daily Calories Card -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/dailyCaloriesCard"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="@dimen/spacing_xs"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="@dimen/elevation_md"
                    app:cardBackgroundColor="@color/white">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/spacing_lg"
                        android:gravity="center">

                        <ImageView
                            android:layout_width="@dimen/icon_size_large"
                            android:layout_height="@dimen/icon_size_large"
                            android:src="@drawable/ic_local_fire_department"
                            android:contentDescription="Calories"
                            app:tint="@color/health_orange"
                            android:layout_marginBottom="@dimen/spacing_sm" />

                        <TextView
                            android:id="@+id/dailyCaloriesNumber"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="1,847"
                            android:textSize="28sp"
                            android:textStyle="bold"
                            android:textColor="@color/health_orange" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Daily Calories"
                            android:textSize="14sp"
                            android:textColor="@color/health_text_secondary"
                            android:layout_marginTop="@dimen/spacing_xs" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="↗️ +12% from yesterday"
                            android:textSize="12sp"
                            android:textColor="@color/health_mint_green"
                            android:layout_marginTop="@dimen/spacing_xs" />

                    </LinearLayout>

                </androidx.cardview.widget.CardView>

                <!-- Average Health Score Card -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/healthScoreCard"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/spacing_xs"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="@dimen/elevation_md"
                    app:cardBackgroundColor="@color/white">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/spacing_lg"
                        android:gravity="center">

                        <!-- Circular Progress Placeholder -->
                        <FrameLayout
                            android:layout_width="80dp"
                            android:layout_height="80dp"
                            android:layout_marginBottom="@dimen/spacing_sm">

                            <ProgressBar
                                android:id="@+id/healthScoreProgress"
                                style="?android:attr/progressBarStyleHorizontal"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:progress="82"
                                android:max="100"
                                android:progressDrawable="@drawable/circular_progress_gradient"
                                android:background="@drawable/circular_progress_background" />

                            <TextView
                                android:id="@+id/healthScoreNumber"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:text="8.2"
                                android:textSize="20sp"
                                android:textStyle="bold"
                                android:textColor="@color/health_mint_green" />

                        </FrameLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Health Score"
                            android:textSize="14sp"
                            android:textColor="@color/health_text_secondary" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="😊 Great choices!"
                            android:textSize="12sp"
                            android:textColor="@color/health_mint_green"
                            android:layout_marginTop="@dimen/spacing_xs" />

                    </LinearLayout>

                </androidx.cardview.widget.CardView>

            </LinearLayout>

            <!-- Most Scanned Categories Card -->
            <androidx.cardview.widget.CardView
                android:id="@+id/categoriesCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/spacing_md"
                app:cardCornerRadius="16dp"
                app:cardElevation="@dimen/elevation_md"
                app:cardBackgroundColor="@color/white"
                android:animation="@anim/slide_up">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_lg">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="@dimen/spacing_md">

                        <ImageView
                            android:layout_width="@dimen/icon_size_medium"
                            android:layout_height="@dimen/icon_size_medium"
                            android:src="@drawable/ic_category"
                            android:contentDescription="Categories"
                            app:tint="@color/health_teal"
                            android:layout_marginEnd="@dimen/spacing_sm" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Most Scanned Categories"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:textColor="@color/health_text_primary" />

                    </LinearLayout>

                    <!-- Category Bars -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <!-- Beverages -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="@dimen/spacing_sm">

                            <TextView
                                android:layout_width="80dp"
                                android:layout_height="wrap_content"
                                android:text="🥤 Beverages"
                                android:textSize="14sp"
                                android:textColor="@color/health_text_primary" />

                            <ProgressBar
                                style="?android:attr/progressBarStyleHorizontal"
                                android:layout_width="0dp"
                                android:layout_height="8dp"
                                android:layout_weight="1"
                                android:layout_marginStart="@dimen/spacing_sm"
                                android:layout_marginEnd="@dimen/spacing_sm"
                                android:progress="85"
                                android:max="100"
                                android:progressDrawable="@drawable/progress_bar_gradient" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="85%"
                                android:textSize="12sp"
                                android:textColor="@color/health_text_secondary" />

                        </LinearLayout>

                        <!-- Snacks -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="@dimen/spacing_sm">

                            <TextView
                                android:layout_width="80dp"
                                android:layout_height="wrap_content"
                                android:text="🍿 Snacks"
                                android:textSize="14sp"
                                android:textColor="@color/health_text_primary" />

                            <ProgressBar
                                style="?android:attr/progressBarStyleHorizontal"
                                android:layout_width="0dp"
                                android:layout_height="8dp"
                                android:layout_weight="1"
                                android:layout_marginStart="@dimen/spacing_sm"
                                android:layout_marginEnd="@dimen/spacing_sm"
                                android:progress="72"
                                android:max="100"
                                android:progressDrawable="@drawable/progress_bar_gradient" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="72%"
                                android:textSize="12sp"
                                android:textColor="@color/health_text_secondary" />

                        </LinearLayout>

                        <!-- Dairy -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="@dimen/spacing_sm">

                            <TextView
                                android:layout_width="80dp"
                                android:layout_height="wrap_content"
                                android:text="🥛 Dairy"
                                android:textSize="14sp"
                                android:textColor="@color/health_text_primary" />

                            <ProgressBar
                                style="?android:attr/progressBarStyleHorizontal"
                                android:layout_width="0dp"
                                android:layout_height="8dp"
                                android:layout_weight="1"
                                android:layout_marginStart="@dimen/spacing_sm"
                                android:layout_marginEnd="@dimen/spacing_sm"
                                android:progress="58"
                                android:max="100"
                                android:progressDrawable="@drawable/progress_bar_gradient" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="58%"
                                android:textSize="12sp"
                                android:textColor="@color/health_text_secondary" />

                        </LinearLayout>

                        <!-- Cereals -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <TextView
                                android:layout_width="80dp"
                                android:layout_height="wrap_content"
                                android:text="🥣 Cereals"
                                android:textSize="14sp"
                                android:textColor="@color/health_text_primary" />

                            <ProgressBar
                                style="?android:attr/progressBarStyleHorizontal"
                                android:layout_width="0dp"
                                android:layout_height="8dp"
                                android:layout_weight="1"
                                android:layout_marginStart="@dimen/spacing_sm"
                                android:layout_marginEnd="@dimen/spacing_sm"
                                android:progress="43"
                                android:max="100"
                                android:progressDrawable="@drawable/progress_bar_gradient" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="43%"
                                android:textSize="12sp"
                                android:textColor="@color/health_text_secondary" />

                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- Weekly Trends Card -->
            <androidx.cardview.widget.CardView
                android:id="@+id/trendsCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/spacing_md"
                app:cardCornerRadius="16dp"
                app:cardElevation="@dimen/elevation_md"
                app:cardBackgroundColor="@color/white"
                android:animation="@anim/slide_up">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_lg">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="@dimen/spacing_md">

                        <ImageView
                            android:layout_width="@dimen/icon_size_medium"
                            android:layout_height="@dimen/icon_size_medium"
                            android:src="@drawable/ic_trending_up"
                            android:contentDescription="Trends"
                            app:tint="@color/health_mint_green"
                            android:layout_marginEnd="@dimen/spacing_sm" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Weekly Health Trends"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:textColor="@color/health_text_primary" />

                    </LinearLayout>

                    <!-- Chart Placeholder -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="120dp"
                        android:orientation="horizontal"
                        android:gravity="bottom"
                        android:layout_marginBottom="@dimen/spacing_md">

                        <!-- Mock Chart Bars -->
                        <View
                            android:layout_width="0dp"
                            android:layout_height="60dp"
                            android:layout_weight="1"
                            android:layout_marginEnd="4dp"
                            android:background="@drawable/chart_bar_gradient" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="80dp"
                            android:layout_weight="1"
                            android:layout_marginEnd="4dp"
                            android:background="@drawable/chart_bar_gradient" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="45dp"
                            android:layout_weight="1"
                            android:layout_marginEnd="4dp"
                            android:background="@drawable/chart_bar_gradient" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="95dp"
                            android:layout_weight="1"
                            android:layout_marginEnd="4dp"
                            android:background="@drawable/chart_bar_gradient" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="70dp"
                            android:layout_weight="1"
                            android:layout_marginEnd="4dp"
                            android:background="@drawable/chart_bar_gradient" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="85dp"
                            android:layout_weight="1"
                            android:layout_marginEnd="4dp"
                            android:background="@drawable/chart_bar_gradient" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="100dp"
                            android:layout_weight="1"
                            android:background="@drawable/chart_bar_gradient" />

                    </LinearLayout>

                    <!-- Chart Labels -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Mon"
                            android:textSize="12sp"
                            android:textColor="@color/health_text_secondary"
                            android:gravity="center" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Tue"
                            android:textSize="12sp"
                            android:textColor="@color/health_text_secondary"
                            android:gravity="center" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Wed"
                            android:textSize="12sp"
                            android:textColor="@color/health_text_secondary"
                            android:gravity="center" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Thu"
                            android:textSize="12sp"
                            android:textColor="@color/health_text_secondary"
                            android:gravity="center" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Fri"
                            android:textSize="12sp"
                            android:textColor="@color/health_text_secondary"
                            android:gravity="center" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Sat"
                            android:textSize="12sp"
                            android:textColor="@color/health_text_secondary"
                            android:gravity="center" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Sun"
                            android:textSize="12sp"
                            android:textColor="@color/health_text_secondary"
                            android:gravity="center" />

                    </LinearLayout>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- Additional Insights Card -->
            <androidx.cardview.widget.CardView
                android:id="@+id/insightsCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/spacing_md"
                app:cardCornerRadius="16dp"
                app:cardElevation="@dimen/elevation_md"
                android:animation="@anim/fade_in">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/tip_card_gradient"
                    android:padding="@dimen/spacing_lg">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="@dimen/spacing_md">

                        <ImageView
                            android:layout_width="@dimen/icon_size_large"
                            android:layout_height="@dimen/icon_size_large"
                            android:src="@drawable/ic_lightbulb"
                            android:contentDescription="Insights"
                            app:tint="@color/white"
                            android:layout_marginEnd="@dimen/spacing_sm" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="💡 Personal Insights"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:textColor="@color/white" />

                    </LinearLayout>

                    <TextView
                        android:id="@+id/personalInsightText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="You've been making healthier choices this week! Your average health score improved by 15%. Keep scanning those nutritious products! 🌟"
                        android:textSize="14sp"
                        android:textColor="@color/white"
                        android:alpha="0.95"
                        android:lineSpacingExtra="2dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="@dimen/spacing_md">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="🎯 Goal: Scan 5 healthy products today"
                            android:textSize="12sp"
                            android:textColor="@color/white"
                            android:alpha="0.9" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="3/5"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="@color/white" />

                    </LinearLayout>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- Classy Bottom Navigation -->
    <include layout="@layout/bottom_nav_classy" />

    <!-- Animation Overlay Container for Circular Reveal -->
    <include layout="@layout/animation_overlay_container" />

</androidx.constraintlayout.widget.ConstraintLayout>