<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/home_bg_clean"
    android:animateLayoutChanges="true"
    tools:context=".AnalyticsActivity">

    <!-- Main Scrollable Content -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:paddingBottom="90dp"
        android:overScrollMode="never"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="16dp"
            android:paddingBottom="32dp">

            <!-- ==================== TOP BAR ==================== -->
            <LinearLayout
                android:id="@+id/headerSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp">

                <!-- Back Button -->
                <FrameLayout
                    android:id="@+id/backButton"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_notification_circle"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackgroundBorderless">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_arrow_back"
                        android:contentDescription="Back"
                        app:tint="#1B1B1B" />
                </FrameLayout>

                <View
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <!-- Refresh Icon -->
                <FrameLayout
                    android:id="@+id/refreshIcon"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_notification_circle"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackgroundBorderless">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_refresh"
                        android:contentDescription="Refresh Analytics"
                        app:tint="#1B1B1B" />
                </FrameLayout>
            </LinearLayout>

            <!-- ==================== HEADLINE ==================== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingEnd="60dp"
                android:paddingTop="8dp"
                android:paddingBottom="4dp">

                <TextView
                    android:id="@+id/analyticsTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Your Health"
                    android:textSize="30sp"
                    android:textStyle="bold"
                    android:textColor="#1B1B1B"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="-0.02"
                    android:lineSpacingMultiplier="1.1" />

                <TextView
                    android:id="@+id/analyticsSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Insights"
                    android:textSize="30sp"
                    android:textStyle="bold"
                    android:textColor="@color/health_teal"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="-0.02"
                    android:lineSpacingMultiplier="1.1" />
            </LinearLayout>

            <!-- ==================== KEY METRICS - 2x2 GRID ==================== -->
            <!-- Row 1 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingTop="20dp"
                android:weightSum="2">

                <!-- Total Scans Card -->
                <LinearLayout
                    android:id="@+id/totalScansCard"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_analytics_metric_card"
                    android:orientation="vertical"
                    android:padding="18dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground">

                    <FrameLayout
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_icon_circle_teal"
                        android:layout_marginBottom="14dp">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_barcode_scan"
                            android:contentDescription="Total Scans"
                            app:tint="@color/health_teal" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/totalScansNumber"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textSize="28sp"
                        android:textStyle="bold"
                        android:textColor="#1B1B1B"
                        android:fontFamily="sans-serif-medium" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Total Scans"
                        android:textSize="13sp"
                        android:textColor="#999B96"
                        android:fontFamily="sans-serif"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

                <!-- Health Score Card -->
                <LinearLayout
                    android:id="@+id/healthScoreCard"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_analytics_metric_card"
                    android:orientation="vertical"
                    android:padding="18dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground">

                    <!-- Circular Progress for Health Score -->
                    <FrameLayout
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_marginBottom="14dp">

                        <ProgressBar
                            android:id="@+id/healthScoreProgress"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:progress="82"
                            android:max="100"
                            android:progressDrawable="@drawable/circular_progress_gradient"
                            android:background="@drawable/circular_progress_background" />

                        <TextView
                            android:id="@+id/healthScoreNumber"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:text="8.2"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="@color/health_teal"
                            android:fontFamily="sans-serif-medium" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Health Score"
                        android:textSize="13sp"
                        android:textColor="#999B96"
                        android:fontFamily="sans-serif"
                        android:layout_marginTop="2dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Average"
                        android:textSize="11sp"
                        android:textColor="#C8CBC5"
                        android:fontFamily="sans-serif"
                        android:layout_marginTop="1dp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Row 2 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingTop="12dp"
                android:weightSum="2">

                <!-- Weekly Scans Card -->
                <LinearLayout
                    android:id="@+id/weeklyScansCard"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_analytics_metric_card"
                    android:orientation="vertical"
                    android:padding="18dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground">

                    <FrameLayout
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_icon_circle_blue"
                        android:layout_marginBottom="14dp">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_trending_up"
                            android:contentDescription="Weekly Scans"
                            app:tint="#2196F3" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/weeklyScansNumber"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="--"
                        android:textSize="28sp"
                        android:textStyle="bold"
                        android:textColor="#1B1B1B"
                        android:fontFamily="sans-serif-medium" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="This Week"
                        android:textSize="13sp"
                        android:textColor="#999B96"
                        android:fontFamily="sans-serif"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

                <!-- Average Calories Card -->
                <LinearLayout
                    android:id="@+id/avgCaloriesCard"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_analytics_metric_card"
                    android:orientation="vertical"
                    android:padding="18dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground">

                    <FrameLayout
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_icon_circle_orange"
                        android:layout_marginBottom="14dp">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_local_fire_department"
                            android:contentDescription="Calories"
                            app:tint="#FF9800" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/avgCaloriesNumber"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="--"
                        android:textSize="28sp"
                        android:textStyle="bold"
                        android:textColor="#1B1B1B"
                        android:fontFamily="sans-serif-medium" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Avg Calories"
                        android:textSize="13sp"
                        android:textColor="#999B96"
                        android:fontFamily="sans-serif"
                        android:layout_marginTop="2dp" />
                </LinearLayout>
            </LinearLayout>

            <!-- ==================== MOST SCANNED CATEGORIES ==================== -->
            <LinearLayout
                android:id="@+id/categoriesCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_recent_scan_card"
                android:orientation="vertical"
                android:padding="22dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="18dp">

                    <FrameLayout
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="@drawable/bg_icon_circle_teal"
                        android:layout_marginEnd="12dp">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_category"
                            android:contentDescription="Categories"
                            app:tint="@color/health_teal" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Most Scanned"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="#1B1B1B"
                        android:fontFamily="sans-serif-medium" />
                </LinearLayout>

                <!-- Category rows are inflated from item_category_bar.xml with real scan data -->
                <LinearLayout
                    android:id="@+id/categoryBarsContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/categoriesEmptyText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/analytics_no_categories"
                    android:textSize="14sp"
                    android:textColor="#999B96"
                    android:fontFamily="sans-serif"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- ==================== WEEKLY TRENDS ==================== -->
            <LinearLayout
                android:id="@+id/trendsCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_recent_scan_card"
                android:orientation="vertical"
                android:padding="22dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="18dp">

                    <FrameLayout
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="@drawable/bg_icon_circle_blue"
                        android:layout_marginEnd="12dp">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_trending_up"
                            android:contentDescription="Trends"
                            app:tint="#2196F3" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Weekly Trends"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:textColor="#1B1B1B"
                            android:fontFamily="sans-serif-medium" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Scans per day"
                            android:textSize="12sp"
                            android:textColor="#999B96"
                            android:fontFamily="sans-serif"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Bars and labels are generated at runtime from the last 7 days of scans -->
                <LinearLayout
                    android:id="@+id/trendBarsContainer"
                    android:layout_width="match_parent"
                    android:layout_height="130dp"
                    android:orientation="horizontal"
                    android:gravity="bottom|center_horizontal"
                    android:layout_marginBottom="10dp" />

                <LinearLayout
                    android:id="@+id/trendLabelsContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="4dp" />
            </LinearLayout>

            <!-- ==================== PERSONAL INSIGHTS ==================== -->
            <LinearLayout
                android:id="@+id/insightsCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_tip_card_clean"
                android:orientation="vertical"
                android:padding="22dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="💡"
                        android:textSize="18sp"
                        android:layout_marginEnd="8dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Personal Insights"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/health_teal"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="0.04" />
                </LinearLayout>

                <TextView
                    android:id="@+id/personalInsightText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="You've been making healthier choices this week! Your average health score improved by 15%. Keep scanning those nutritious products! 🌟"
                    android:textSize="14sp"
                    android:textColor="#2E3630"
                    android:fontFamily="sans-serif"
                    android:lineSpacingMultiplier="1.4" />

                <!-- Goal Progress -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_settings_section_header"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="🎯 Goal: Scan 5 healthy products today"
                        android:textSize="12sp"
                        android:textColor="#4A7C59"
                        android:fontFamily="sans-serif-medium" />

                    <TextView
                        android:id="@+id/goalProgressText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0/5"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/health_teal"
                        android:fontFamily="sans-serif-medium" />
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- Classy Bottom Navigation -->
    <include layout="@layout/bottom_nav_classy" />

    <!-- Animation Overlay Container for Circular Reveal -->
    <include layout="@layout/animation_overlay_container" />

</androidx.constraintlayout.widget.ConstraintLayout>
