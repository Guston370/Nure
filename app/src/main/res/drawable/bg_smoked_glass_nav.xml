<?xml version="1.0" encoding="utf-8"?>
<!-- Nure — Premium Smoked Glass Navigation Pill -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Ambient shadow layer -->
    <item
        android:left="4dp"
        android:right="4dp"
        android:top="4dp"
        android:bottom="-4dp">
        <shape>
            <corners android:radius="36dp" />
            <solid android:color="#40000000" />
        </shape>
    </item>

    <!-- Smoked glass base -->
    <item>
        <shape>
            <corners android:radius="36dp" />
            <solid android:color="#E0141419" />
        </shape>
    </item>

    <!-- Top reflection sheen -->
    <item
        android:bottom="36dp"
        android:left="0dp"
        android:right="0dp"
        android:top="0dp">
        <shape>
            <corners
                android:topLeftRadius="36dp"
                android:topRightRadius="36dp"
                android:bottomLeftRadius="0dp"
                android:bottomRightRadius="0dp" />
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#14FFFFFF"
                android:endColor="#00FFFFFF" />
        </shape>
    </item>

    <!-- Glass border -->
    <item>
        <shape>
            <corners android:radius="36dp" />
            <stroke
                android:width="1dp"
                android:color="#1FFFFFFF" />
        </shape>
    </item>

</layer-list>
