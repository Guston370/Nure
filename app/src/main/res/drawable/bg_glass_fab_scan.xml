<?xml version="1.0" encoding="utf-8"?>
<!-- Nure — Smoked Glass FAB Scan Button -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Glow shadow -->
    <item
        android:left="3dp"
        android:right="3dp"
        android:top="3dp"
        android:bottom="-4dp">
        <shape>
            <corners android:radius="34dp" />
            <solid android:color="#4006B6D4" />
        </shape>
    </item>

    <!-- Gradient background -->
    <item>
        <shape>
            <corners android:radius="34dp" />
            <gradient
                android:type="linear"
                android:angle="135"
                android:startColor="#FF06B6D4"
                android:centerColor="#FF0891B2"
                android:endColor="#FF10B981" />
        </shape>
    </item>

    <!-- Top reflection sheen -->
    <item
        android:bottom="34dp">
        <shape>
            <corners
                android:topLeftRadius="34dp"
                android:topRightRadius="34dp"
                android:bottomLeftRadius="0dp"
                android:bottomRightRadius="0dp" />
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#30FFFFFF"
                android:endColor="#00FFFFFF" />
        </shape>
    </item>

</layer-list>
