<?xml version="1.0" encoding="utf-8"?>
<!-- Glass Sidebar Panel - semi-transparent surface -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <corners android:topRightRadius="32dp" android:bottomRightRadius="32dp" />
            <solid android:color="@color/glass_sidebar_background" />
        </shape>
    </item>
    <item>
        <shape>
            <corners android:topRightRadius="32dp" android:bottomRightRadius="32dp" />
            <gradient
                android:type="linear"
                android:angle="0"
                android:startColor="@color/glass_sidebar_sheen_start"
                android:endColor="@color/glass_sidebar_sheen_end" />
            <stroke
                android:width="1dp"
                android:color="@color/glass_sidebar_stroke" />
        </shape>
    </item>
</layer-list>
