<?xml version="1.0" encoding="utf-8"?>
<!-- Enhanced bottom navigation icon selector with vibrant health colors -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    
    <!-- Selected state - adaptive primary color -->
    <item android:state_checked="true">
        <color android:color="@color/bottom_nav_icon_active" />
    </item>
    
    <!-- Pressed state - adaptive primary color -->
    <item android:state_pressed="true">
        <color android:color="@color/bottom_nav_icon_active" />
    </item>
    
    <!-- Focused state -->
    <item android:state_focused="true">
        <color android:color="@color/bottom_nav_icon_active" />
    </item>
    
    <!-- Default state - adaptive secondary color -->
    <item>
        <color android:color="@color/bottom_nav_icon_inactive" />
    </item>
    
</selector>

