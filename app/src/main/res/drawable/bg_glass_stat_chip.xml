<?xml version="1.0" encoding="utf-8"?>
<!-- Glass Stat Chip - small frosted pill for stats -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <corners android:radius="20dp" />
            <solid android:color="@color/glass_nav_bar_background" />
        </shape>
    </item>
    <item>
        <shape>
            <corners android:radius="20dp" />
            <gradient
                android:type="linear"
                android:angle="145"
                android:startColor="@color/glass_nav_bar_sheen_start"
                android:endColor="@color/glass_nav_bar_sheen_end" />
            <stroke
                android:width="1dp"
                android:color="@color/glass_nav_bar_stroke" />
        </shape>
    </item>
</layer-list>
