<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive Glass Card using theme colors -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Glass base surface -->
    <item>
        <shape>
            <corners android:radius="24dp" />
            <solid android:color="@color/glass_card_background" />
        </shape>
    </item>
    <!-- Sheen/Border depth effect -->
    <item>
        <shape>
            <corners android:radius="24dp" />
            <gradient
                android:type="linear"
                android:angle="145"
                android:startColor="@color/glass_card_sheen_start"
                android:endColor="@color/glass_card_sheen_end" />
            <stroke
                android:width="1dp"
                android:color="@color/glass_card_stroke" />
        </shape>
    </item>
</layer-list>
