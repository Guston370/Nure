<?xml version="1.0" encoding="utf-8"?>
<!-- Glass Search Bar - frosted pill -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <corners android:radius="100dp" />
            <solid android:color="@color/glass_card_background" />
        </shape>
    </item>
    <item>
        <shape>
            <corners android:radius="100dp" />
            <gradient
                android:type="linear"
                android:angle="135"
                android:startColor="@color/glass_card_sheen_start"
                android:endColor="@color/glass_card_sheen_end" />
            <stroke
                android:width="1dp"
                android:color="@color/glass_card_stroke" />
        </shape>
    </item>
</layer-list>
