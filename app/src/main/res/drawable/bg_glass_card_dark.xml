<?xml version="1.0" encoding="utf-8"?>
<!-- Glass Card - Dark Mode: frosted navy with glowing border -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Dark glass base -->
    <item>
        <shape>
            <corners android:radius="24dp" />
            <solid android:color="#CC1E293B" />
        </shape>
    </item>
    <!-- Glass gradient sheen -->
    <item>
        <shape>
            <corners android:radius="24dp" />
            <gradient
                android:type="linear"
                android:angle="145"
                android:startColor="#1AFFFFFF"
                android:endColor="#05FFFFFF" />
            <stroke
                android:width="1dp"
                android:color="#3334D399" />
        </shape>
    </item>
</layer-list>
