<?xml version="1.0" encoding="utf-8"?>
<!-- Glass Tip Card - frosted card with emerald gradient left border accent -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Main glass surface -->
    <item>
        <shape>
            <corners android:radius="20dp" />
            <solid android:color="@color/glass_tip_card_background" />
        </shape>
    </item>
    <!-- Gradient sheen -->
    <item>
        <shape>
            <corners android:radius="20dp" />
            <gradient
                android:type="linear"
                android:angle="145"
                android:startColor="#1A10B981"
                android:endColor="#0A06B6D4" />
            <stroke
                android:width="1dp"
                android:color="#2610B981" />
        </shape>
    </item>
</layer-list>
