<?xml version="1.0" encoding="utf-8"?>
<!-- Nure — Smoked Glass Nav Bar (updated from white to dark) -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Smoked glass base -->
    <item>
        <shape>
            <corners android:radius="36dp" />
            <solid android:color="#E0141419" />
        </shape>
    </item>
    <!-- Glass sheen -->
    <item>
        <shape>
            <corners android:radius="36dp" />
            <gradient
                android:type="linear"
                android:angle="135"
                android:startColor="#14FFFFFF"
                android:endColor="#05FFFFFF" />
            <stroke
                android:width="1dp"
                android:color="#1FFFFFFF" />
        </shape>
    </item>
</layer-list>
