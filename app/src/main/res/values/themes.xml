<?xml version="1.0" encoding="utf-8"?>
<!-- Nure Health Scanner - Premium Smoked-Glass Dark Theme System -->
<resources>

    <!-- ==================== BASE THEME ==================== -->
    <style name="Base.Theme.HealthScanner" parent="Theme.Material3.DayNight">
        <!-- Primary - Cyan #06B6D4 -->
        <item name="colorPrimary">@color/md_theme_light_primary</item>
        <item name="colorOnPrimary">@color/md_theme_light_onPrimary</item>
        <item name="colorPrimaryContainer">@color/md_theme_light_primaryContainer</item>
        <item name="colorOnPrimaryContainer">@color/md_theme_light_onPrimaryContainer</item>

        <!-- Secondary - Emerald -->
        <item name="colorSecondary">@color/md_theme_light_secondary</item>
        <item name="colorOnSecondary">@color/md_theme_light_onSecondary</item>
        <item name="colorSecondaryContainer">@color/md_theme_light_secondaryContainer</item>
        <item name="colorOnSecondaryContainer">@color/md_theme_light_onSecondaryContainer</item>

        <!-- Tertiary - Violet -->
        <item name="colorTertiary">@color/md_theme_light_tertiary</item>
        <item name="colorOnTertiary">@color/md_theme_light_onTertiary</item>
        <item name="colorTertiaryContainer">@color/md_theme_light_tertiaryContainer</item>
        <item name="colorOnTertiaryContainer">@color/md_theme_light_onTertiaryContainer</item>

        <!-- Error -->
        <item name="colorError">@color/md_theme_light_error</item>
        <item name="colorOnError">@color/md_theme_light_onError</item>
        <item name="colorErrorContainer">@color/md_theme_light_errorContainer</item>
        <item name="colorOnErrorContainer">@color/md_theme_light_onErrorContainer</item>

        <!-- Background - Deep Navy -->
        <item name="android:colorBackground">@color/md_theme_light_background</item>
        <item name="colorOnBackground">@color/md_theme_light_onBackground</item>

        <!-- Surface -->
        <item name="colorSurface">@color/md_theme_light_surface</item>
        <item name="colorOnSurface">@color/md_theme_light_onSurface</item>
        <item name="colorSurfaceVariant">@color/md_theme_light_surfaceVariant</item>
        <item name="colorOnSurfaceVariant">@color/md_theme_light_onSurfaceVariant</item>
        <item name="colorSurfaceContainer">@color/md_theme_light_surfaceContainer</item>

        <!-- Outline -->
        <item name="colorOutline">@color/md_theme_light_outline</item>
        <item name="colorSurfaceInverse">@color/md_theme_light_inverseSurface</item>
        <item name="colorOnSurfaceInverse">@color/md_theme_light_inverseOnSurface</item>
        <item name="colorPrimaryInverse">@color/md_theme_light_inversePrimary</item>

        <!-- Status Bar - transparent, dark icons -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>

        <!-- Navigation Bar - deep navy -->
        <item name="android:navigationBarColor">@color/bg_deep_navy</item>

        <!-- Window Background -->
        <item name="android:windowBackground">@color/md_theme_light_background</item>

        <!-- Control Colors -->
        <item name="colorControlNormal">@color/md_theme_light_onSurfaceVariant</item>
        <item name="colorControlActivated">@color/md_theme_light_primary</item>
        <item name="colorControlHighlight">@color/ripple_light</item>
    </style>

    <!-- ==================== MAIN APPLICATION THEME ==================== -->
    <style name="Theme.HealthScanner" parent="Base.Theme.HealthScanner">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>

    <!-- ==================== LOGIN THEME — Smoked Glass Dark ==================== -->
    <style name="Theme.HealthScanner.Login" parent="Theme.HealthScanner">
        <item name="android:windowBackground">@drawable/gradient_page_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowTranslucentStatus">false</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:navigationBarColor">@color/bg_deep_navy</item>
    </style>

    <!-- ==================== SPLASH THEME ==================== -->
    <style name="Theme.HealthScanner.Splash" parent="Theme.HealthScanner">
        <item name="android:windowBackground">@drawable/gradient_page_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>

    <!-- ==================== SCANNER THEME — Premium Dark ==================== -->
    <style name="Theme.HealthScanner.Scanner" parent="Theme.HealthScanner">
        <item name="android:windowBackground">@color/black</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/black</item>
        <item name="colorPrimary">@color/scan_active</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>

    <!-- ==================== GLASS OVERLAY THEME ==================== -->
    <style name="Theme.HealthScanner.Glass" parent="Theme.HealthScanner">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>

    <!-- ==================== PROFILE / FULL-SCREEN THEME ==================== -->
    <style name="Theme.HealthScanner.Profile" parent="Theme.HealthScanner">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:navigationBarColor">@color/bg_deep_navy</item>
    </style>

    <!-- ==================== BOTTOM SHEET THEME ==================== -->
    <style name="Theme.HealthScanner.BottomSheet" parent="Theme.Material3.DayNight.BottomSheetDialog">
        <item name="colorPrimary">@color/md_theme_light_primary</item>
        <item name="colorSurface">@color/md_theme_light_surfaceVariant</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowSoftInputMode">adjustResize</item>
    </style>

    <!-- ==================== ALERT DIALOG THEME ==================== -->
    <style name="Theme.HealthScanner.AlertDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorPrimary">@color/md_theme_light_primary</item>
        <item name="colorSurface">@color/md_theme_light_surfaceVariant</item>
        <item name="android:background">@color/md_theme_light_surfaceVariant</item>
    </style>

</resources>