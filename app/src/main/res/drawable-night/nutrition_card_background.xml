<?xml version="1.0" encoding="utf-8"?>
<!-- Nutrition card background - Dark Mode -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    
    <!-- Dark background -->
    <solid android:color="@color/md_theme_dark_surfaceVariant" />
    
    <!-- Rounded corners -->
    <corners android:radius="12dp" />
    
    <!-- Border -->
    <stroke 
        android:width="1dp" 
        android:color="@color/md_theme_dark_outline" />
    
</shape>